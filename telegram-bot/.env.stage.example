# telegram-bot/.env.stage — template for the staging Telegram bot worker.
#
# Usage:
#   cp telegram-bot/.env.stage.example telegram-bot/.env.stage
#   # edit telegram-bot/.env.stage, filling every <<FILL_*>> placeholder
#   scp telegram-bot/.env.stage muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven-stage/telegram-bot/.env.stage
#
# The filled .env.stage is gitignored (see root .gitignore).
#
# Topology summary (matches the existing +1000-host-port-offset convention):
#   Host port:           4004      (mapped to 3004 inside the container)
#   Container port:      3004      (PORT below — DO NOT change without
#                                   updating docker-compose.stage.yml)
#   Cloudflare tunnel:   tg-stage.muhaven.app → http://localhost:4004
#   Telegram webhook:    https://tg-stage.muhaven.app/webhook
#                        (path is hardcoded at telegram-bot/src/index.ts:120)
#
# After editing, redeploy with `pnpm run deploy:homelab:stage`. A bare
# `docker compose restart` does NOT pick up env_file changes — the
# container's env is locked at create time (see memory
# `feedback_compose_restart_env_file`).

# ── REQUIRED ────────────────────────────────────────────────────────
# Bot token from @BotFather. Use a SEPARATE bot from prod (@BotFather →
# /newbot → e.g. `muhaven_stage_bot`). Sharing a bot between stage and
# prod would cross-route confirmation flows.
TELEGRAM_BOT_TOKEN=<<FILL_STAGING_BOTFATHER_TOKEN>>

# Bot username without leading `@` (e.g. muhaven_stage_bot — must end in
# `_bot` per Telegram's username rules). MUST match the bot that issued
# TELEGRAM_BOT_TOKEN above; the deep-link `t.me/<username>?start=…`
# resolves on Telegram's side using this string.
TELEGRAM_BOT_USERNAME=<<FILL_STAGING_BOT_USERNAME>>

# Service-to-service secret. MUST match the value the staging backend
# reads from TELEGRAM_BOT_SERVICE_SECRET in backend/.env.stage. ≥32 chars.
# Generate fresh — do NOT reuse prod's. Command:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_BOT_SERVICE_SECRET=<<FILL_STAGING_SERVICE_SECRET_64_HEX_CHARS>>

# Webhook secret token Telegram echoes on the X-Telegram-Bot-Api-Secret-Token
# header for every POST. ≥16 chars (worker enforces; Telegram allows 1-256
# chars from [A-Z a-z 0-9 _ -]). The SAME value MUST be passed to
# Telegram's setWebhook API call as `secret_token`. Generate fresh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Register the webhook (one-time, after the staging stack is up):
#   curl -F "url=https://tg-stage.muhaven.app/webhook" \
#        -F "secret_token=$TELEGRAM_WEBHOOK_SECRET_TOKEN" \
#        -F 'allowed_updates=["message","callback_query"]' \
#        https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=<<FILL_STAGING_WEBHOOK_SECRET_32_HEX_CHARS>>

# ── OPTIONAL (but ON for staging) ───────────────────────────────────
# Public URL Telegram POSTs updates to. Routed via the Cloudflare tunnel
# `tg-stage.muhaven.app` → host port 4004 → container port 3004. When unset
# the worker falls back to long-polling — fine for local dev, but staging
# should exercise the same webhook path prod will use. The path `/webhook`
# is hardcoded at `telegram-bot/src/index.ts:120`.
TELEGRAM_WEBHOOK_URL=https://tg-stage.muhaven.app/webhook

# Mini App URL (the `web_app` button on the mid-tier inline keyboard,
# $200–$5K). Staging Mini App lives on the same dashboard origin as the
# regular SPA — Vite serves it from /telegram-mini-app under
# stage.muhaven.app.
TELEGRAM_MINI_APP_URL=https://stage.muhaven.app/telegram-mini-app

# Dashboard origin used by the >$5K passkey deep-link tier. Staging
# dashboard so the WebAuthn RP-ID resolves correctly (RP-ID binding to
# muhaven.app would break the passkey ceremony on the staging path).
MUHAVEN_DASHBOARD_URL=https://stage.muhaven.app

# Backend base URL inside the docker network. The staging backend container
# is named `backend` on the muhaven-stage docker network — same internal
# port 3000 as prod (the +1000 offset is host-side only; container ports
# are unchanged). DO NOT use the public Cloudflare URL here — that would
# round-trip the bot's outbound calls through the internet.
TELEGRAM_BOT_BACKEND_URL=http://backend:3000

# Listen port (in-container — must match docker-compose.stage.yml's
# `4004:3004` mapping). Changing this requires a parallel edit to the
# compose file's port mapping.
PORT=3004

# ── Wave 4 P7 (optional, deferred) ──────────────────────────────────
# Telegram channel id (numeric, e.g. -1001234567890) the worker posts
# issuer-narrative events to (distribution-funded, KYC-changed, token-
# unpaused). Operator setup deferred to the grant-submission window. When
# unset the broadcast endpoint logs + drops, which is the correct staging
# behaviour while the public channel is not yet provisioned. To enable:
# create a public Telegram channel, add the bot as admin with post
# privileges, fetch the chat-id via getChat or @getidsbot, paste below.
# TELEGRAM_ISSUER_CHANNEL_ID=-1001234567890

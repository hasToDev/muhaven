# telegram-bot/.env — template for the production Telegram bot worker.
#
# Usage:
#   cp telegram-bot/.env.example telegram-bot/.env
#   # edit telegram-bot/.env, filling every <<FILL_*>> placeholder
#   scp telegram-bot/.env muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven/telegram-bot/.env
#
# The filled .env is gitignored (see root .gitignore).
#
# Topology summary:
#   Host port:           3004      (mapped to 3004 inside the container —
#                                   prod has no offset; container == host)
#   Container port:      3004      (PORT below — DO NOT change without
#                                   updating docker-compose.yml)
#   Cloudflare tunnel:   tg.muhaven.app (or analog) → http://localhost:3004
#   Telegram webhook:    https://tg.muhaven.app/webhook
#                        (path is hardcoded at telegram-bot/src/index.ts:120)
#
# Leave this file absent / commented to disable the integration; the
# docker-compose service crash-loops harmlessly without these.

# ── REQUIRED ────────────────────────────────────────────────────────
# Bot token from @BotFather. Production bot only — staging uses a
# SEPARATE bot (see telegram-bot/.env.stage.example).
TELEGRAM_BOT_TOKEN=<<FILL_PROD_BOTFATHER_TOKEN>>

# Bot username without leading `@` (e.g. muhaven_bot — must end in `_bot`
# per Telegram's username rules).
TELEGRAM_BOT_USERNAME=<<FILL_PROD_BOT_USERNAME>>

# Service-to-service secret. MUST match the value the backend reads from
# TELEGRAM_BOT_SERVICE_SECRET in backend/.env. ≥32 chars. Generate fresh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_BOT_SERVICE_SECRET=<<FILL_PROD_SERVICE_SECRET_64_HEX_CHARS>>

# Webhook secret token Telegram echoes on the X-Telegram-Bot-Api-Secret-Token
# header for every POST. ≥16 chars (worker enforces; Telegram allows 1-256
# chars from [A-Z a-z 0-9 _ -]). The SAME value MUST be passed to
# Telegram's setWebhook API call as `secret_token`. Generate fresh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET_TOKEN=<<FILL_PROD_WEBHOOK_SECRET_32_HEX_CHARS>>

# ── OPTIONAL ────────────────────────────────────────────────────────
# Public URL Telegram POSTs updates to. When unset, the worker falls
# back to long-poll mode (good for local dev where Telegram cannot reach
# you). The path `/webhook` is hardcoded at `telegram-bot/src/index.ts:120`.
# TELEGRAM_WEBHOOK_URL=https://tg.muhaven.app/webhook

# Mini App URL (the `web_app` button on the mid-tier inline keyboard,
# $200–$5K). Vite serves the Mini App at /telegram-mini-app under the
# dashboard origin.
TELEGRAM_MINI_APP_URL=https://muhaven.app/telegram-mini-app

# Dashboard origin used by the >$5K passkey deep-link tier. Production
# WebAuthn RP-ID is bound to this origin.
MUHAVEN_DASHBOARD_URL=https://muhaven.app

# Backend base URL inside the docker network. Container name `backend`
# resolves on the muhaven docker network. DO NOT use the public Cloudflare
# URL — that would round-trip the bot's outbound calls through the
# internet.
TELEGRAM_BOT_BACKEND_URL=http://backend:3000

# Listen port (in-container — must match docker-compose.yml's port
# mapping). Changing this requires a parallel edit to the compose file.
PORT=3004

# ── Wave 4 P7 (optional, deferred) ──────────────────────────────────
# Telegram channel id (numeric, e.g. -1001234567890) the worker posts
# issuer-narrative events to (distribution-funded, KYC-changed, token-
# unpaused). Operator setup deferred to the grant-submission window. When
# unset the broadcast endpoint logs + drops. To enable: create a public
# Telegram channel, add the bot as admin with post privileges, fetch
# the chat-id via getChat or @getidsbot, paste below.
# TELEGRAM_ISSUER_CHANNEL_ID=-1001234567890

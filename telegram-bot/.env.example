# MuHaven Telegram bot worker — env example.
# Copy to .env and fill in. Leave the file absent / commented to disable
# the integration; the docker-compose service crash-loops harmlessly
# without these.

# ── REQUIRED ────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Bot username without leading `@` (e.g. muhaven_bot)
TELEGRAM_BOT_USERNAME=

# Service-to-service secret. MUST match the value the backend reads
# from TELEGRAM_BOT_SERVICE_SECRET in backend/.env. ≥32 chars.
TELEGRAM_BOT_SERVICE_SECRET=

# Telegram echoes this header on every webhook request. ≥16 chars.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ── OPTIONAL ────────────────────────────────────────────────────────
# Public URL Telegram POSTs to. When unset, the worker falls back to
# long-poll mode (good for local dev where Telegram cannot reach you).
# Production:  https://nagreg.hasto.dev/telegram-bot/webhook
TELEGRAM_WEBHOOK_URL=

# Mini App URL (the `web_app` button on the inline keyboard).
TELEGRAM_MINI_APP_URL=https://muhaven.hasto.dev/telegram-mini-app

# Dashboard origin used by the >$5K passkey deep-link.
MUHAVEN_DASHBOARD_URL=https://muhaven.hasto.dev

# Backend base URL inside the docker network.
TELEGRAM_BOT_BACKEND_URL=http://backend:3000

# Listen port (matches docker-compose).
PORT=3004

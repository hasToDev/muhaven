{
  "name": "@muhaven/fhe-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "description": "MuHaven FHE encryption worker — wraps @cofhe/sdk/node for server-side encryption",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --outDir dist",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cofhe/sdk": "^0.5.1",
    "tfhe": "1.5.3",
    "viem": "^2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.7"
  },
  "license": "MIT"
}

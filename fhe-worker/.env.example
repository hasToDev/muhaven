# FHE Worker Configuration
PORT=3001

# Chain RPC (for CoFHE client connection)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Private key for FHE worker (used for CoFHE client initialization)
# This should be a dedicated key, NOT the deployer key
FHE_WORKER_PRIVATE_KEY=

# ── Wave 5 Path D Slice 1 Commit 3.5 — shared secret gate ───────────────
# Gates `POST /api/v1/encrypt/for-account` (the Path D autonomous-buy
# mediation endpoint). When set, the worker checks the incoming
# `X-FHE-Worker-Secret` header against this value and 401s on mismatch.
# When unset on either this side OR the backend, the gate is open for
# back-compat. Legacy `/api/v1/encrypt/batch` is NOT gated (Wave 3
# escrow back-compat).
#
# Production hardening = set the SAME value here AND in backend/.env's
# `FHE_WORKER_SHARED_SECRET`. Generate as 32 random bytes hex:
#   openssl rand -hex 32
FHE_WORKER_SHARED_SECRET=

# fhe-worker/.env.stage — template for the staging FHE worker service.
#
# Usage:
#   cp fhe-worker/.env.stage.example fhe-worker/.env.stage
#   # edit fhe-worker/.env.stage, filling the <<FILL_*>> placeholder
#   scp fhe-worker/.env.stage muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven-stage/fhe-worker/.env.stage

# In-container port. Host-side port (4001) is set in docker-compose.stage.yml —
# each compose stack runs on its own docker network, so internal ports can
# match prod without conflict.
PORT=3001

# Chain RPC (for CoFHE client connection)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Dedicated staging FHE worker key — NOT the deployer and NOT prod's FHE key.
# Must be funded with Arb Sepolia ETH for decrypt-task submissions.
FHE_WORKER_PRIVATE_KEY=<<FILL_STAGING_FHE_WORKER_PRIVATE_KEY>>

# ── Wave 5 Path D Slice 1 Commit 3.5 — shared secret gate ───────────────
# Gates `POST /api/v1/encrypt/for-account` (the Path D autonomous-buy
# mediation endpoint). Worker checks the `X-FHE-Worker-Secret` header
# against this value; 401s on mismatch. When unset on either side
# (worker OR backend) the gate is open for back-compat. Legacy
# `/api/v1/encrypt/batch` is NOT gated.
#
# MUST match `FHE_WORKER_SHARED_SECRET` in backend/.env.stage. Generate
# fresh per environment — do NOT reuse the prod secret:
#   openssl rand -hex 32
FHE_WORKER_SHARED_SECRET=<<FILL_STAGING_FHE_WORKER_SHARED_SECRET>>

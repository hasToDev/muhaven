{
	"name": "muhaven",
	"version": "0.1.0",
	"description": "MuHaven — confidential RWA portfolio management on Fhenix CoFHE",
	"scripts": {
		"test": "hardhat test",
		"compile": "hardhat compile",
		"clean": "rimraf ./artifacts ./cache ./coverage ./types ./coverage.json",
		"task:deploy": "hardhat deploy",
		"localcofhe:start": "hardhat localcofhe:start --clean true",
		"localcofhe:test": "REPORT_GAS=true hardhat test --network localcofhe",
		"localcofhe:stop": "hardhat localcofhe:stop",
		"deploy:local": "hardhat run scripts/deploy.ts",
		"deploy:testnet": "MUHAVEN_ENV=prod hardhat run scripts/deploy.ts --network arb-sepolia",
		"deploy:testnet:stage": "MUHAVEN_ENV=staging hardhat run scripts/deploy.ts --network arb-sepolia",
		"deploy:v2:local": "hardhat run scripts/deploy-v2.ts",
		"deploy:v2:testnet": "MUHAVEN_ENV=prod hardhat run scripts/deploy-v2.ts --network arb-sepolia",
		"deploy:v2:testnet:stage": "MUHAVEN_ENV=staging hardhat run scripts/deploy-v2.ts --network arb-sepolia",
		"onboard-token:local": "hardhat run scripts/onboard-token.ts",
		"onboard-token:testnet": "MUHAVEN_ENV=prod hardhat run scripts/onboard-token.ts --network arb-sepolia",
		"onboard-token:testnet:stage": "MUHAVEN_ENV=staging hardhat run scripts/onboard-token.ts --network arb-sepolia",
		"bulk-import-whitelist:testnet": "MUHAVEN_ENV=prod hardhat run scripts/bulk-import-whitelist.ts --network arb-sepolia",
		"bulk-import-whitelist:testnet:stage": "MUHAVEN_ENV=staging hardhat run scripts/bulk-import-whitelist.ts --network arb-sepolia",
		"wrap-test-usdc:testnet": "MUHAVEN_ENV=prod hardhat run scripts/wrap-test-usdc.ts --network arb-sepolia",
		"wrap-test-usdc:testnet:stage": "MUHAVEN_ENV=staging hardhat run scripts/wrap-test-usdc.ts --network arb-sepolia",
		"deploy:mocks": "hardhat run scripts/deploy-mocks.ts",
		"deploy:mocks:testnet": "hardhat run scripts/deploy-mocks.ts --network arb-sepolia",
		"validate:reineira": "hardhat run scripts/validate-reineira.ts --network arb-sepolia",
		"deploy:homelab": "bash scripts/deploy-homelab.sh prod",
		"deploy:homelab:stage": "bash scripts/deploy-homelab.sh stage",
		"test:auth": "tsx scripts/test-auth.ts",
		"test:auth:homelab": "tsx scripts/test-auth.ts https://nagreg.hasto.dev",
		"test:testnet": "hardhat run scripts/test-testnet.ts --network arb-sepolia",
		"test:yield:testnet": "hardhat run scripts/test-yield-testnet.ts --network arb-sepolia",
		"test:e2e:sdk": "hardhat run scripts/test-e2e-sdk.ts --network arb-sepolia",
		"deploy:diagnostic": "hardhat run scripts/deploy-diagnostic.ts --network arb-sepolia",
		"test:diagnostic": "hardhat run scripts/test-diagnostic.ts --network arb-sepolia",
		"setup:e2e": "hardhat run scripts/setup-e2e.ts --network arb-sepolia",
		"bench:cofhe-latency": "hardhat run scripts/bench/cofhe-decrypt-latency.ts --network arb-sepolia",
		"lint:trifecta": "tsx scripts/lethal-trifecta-lint.ts",
		"lint:trifecta:strict": "tsx scripts/lethal-trifecta-lint.ts --strict"
	},
	"author": "hasToDev",
	"license": "MIT",
	"devDependencies": {
		"@cofhe/hardhat-plugin": "^0.5.1",
		"@cofhe/mock-contracts": "^0.5.1",
		"@cofhe/sdk": "^0.5.1",
		"@fhenixprotocol/cofhe-contracts": "^0.1.3",
		"@muhaven/sdk": "workspace:*",
		"@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
		"@nomicfoundation/hardhat-ethers": "^3.0.0",
		"@nomicfoundation/hardhat-ignition": "^0.15.0",
		"@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
		"@nomicfoundation/hardhat-network-helpers": "^1.0.0",
		"@nomicfoundation/hardhat-toolbox": "^5.0.0",
		"@nomicfoundation/hardhat-verify": "^2.0.0",
		"@openzeppelin/contracts": "^5.0.0",
		"@openzeppelin/contracts-upgradeable": "^5.0.0",
		"@openzeppelin/hardhat-upgrades": "^3.0.0",
		"@typechain/ethers-v6": "^0.5.0",
		"@typechain/hardhat": "^9.0.0",
		"@types/chai": "^4.2.0",
		"@types/mocha": ">=9.1.0",
		"@types/node": ">=18.0.0",
		"chai": "^4.2.0",
		"dotenv": "^16.4.7",
		"ethers": "^6.4.0",
		"hardhat": "^2.22.19",
		"hardhat-gas-reporter": "^1.0.8",
		"rimraf": "^5.0.0",
		"solidity-coverage": "^0.8.0",
		"ts-node": ">=8.0.0",
		"tsx": "^4.21.0",
		"typechain": "^8.3.0",
		"typescript": "^5.7.0",
		"viem": "^2.48.1",
		"wrangler": "^4.86.0"
	}
}

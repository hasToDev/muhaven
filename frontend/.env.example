# ZeroDev — smart account + passkey auth (Arbitrum Sepolia)
# Get these from https://dashboard.zerodev.app
# Bundler URL includes chain ID suffix — copy the full URL from dashboard
VITE_ZERODEV_BUNDLER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/421614
VITE_ZERODEV_PASSKEY_SERVER_URL=https://passkeys.zerodev.app/api/v3/YOUR_PROJECT_ID

# Backend API base URL
VITE_API_BASE_URL=https://nagreg.hasto.dev/api/v1

# Chain
VITE_CHAIN_ID=421614

# MuHaven contract addresses — leave blank to fall back to the baked-in
# addresses in src/contracts/addresses.ts. Staging fills these from
# deployments/arb-sepolia.staging.json.
VITE_MUHAVEN_TOKEN_ADDRESS=
VITE_MUHAVEN_VAULT_ADDRESS=
VITE_INVESTOR_REGISTRY_ADDRESS=
VITE_YIELD_DISTRIBUTOR_ADDRESS=
VITE_KYC_ADAPTER_ADDRESS=
VITE_RISK_PARAMS_ADDRESS=
VITE_YIELD_GATE_ADDRESS=
VITE_MUHAVEN_ESCROW_ADDRESS=

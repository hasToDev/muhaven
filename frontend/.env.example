# frontend/.env — production frontend build / dev.
#
# Usage:
#   cp frontend/.env.example frontend/.env
#   # then for local dev: bun run dev (vite default mode reads .env)
#   # or for the prod build: bun run build → ../muhaven-web
#
# The real .env is gitignored (see root .gitignore). Same key set as
# .env.stage.example — keep them in lockstep when adding a new key.

# ZeroDev — smart account + passkey auth (Arbitrum Sepolia)
# Get these from https://dashboard.zerodev.app
# Bundler URL includes chain ID suffix — copy the full URL from dashboard.
# Domain field in dashboard MUST be `https://muhaven.hasto.dev` (full URL,
# not bare hostname — see memory feedback_zerodev_domain_https_prefix).
VITE_ZERODEV_BUNDLER_URL=https://rpc.zerodev.app/api/v3/YOUR_PROJECT_ID/chain/421614
VITE_ZERODEV_PASSKEY_SERVER_URL=https://passkeys.zerodev.app/api/v3/YOUR_PROJECT_ID

# Backend API base URL
VITE_API_BASE_URL=https://nagreg.hasto.dev/api/v1

# Chain
VITE_CHAIN_ID=421614
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional — session-key TTL (seconds). Default 3600.
# VITE_SESSION_KEY_DURATION_SEC=3600

# ── Wave 3 contract addresses (read-only legacy view paths) ────────────
# Source: deployments/arb-sepolia.json. Wave 3 escrow flow is retired in
# Wave 3.5 but a few legacy view paths still resolve through these slots.
# Leave blank to fall back to the baked-in defaults in
# src/contracts/addresses.ts.
VITE_MUHAVEN_TOKEN_ADDRESS=
VITE_MUHAVEN_VAULT_ADDRESS=
VITE_YIELD_DISTRIBUTOR_ADDRESS=
VITE_KYC_ADAPTER_ADDRESS=
VITE_RISK_PARAMS_ADDRESS=
VITE_YIELD_GATE_ADDRESS=
VITE_MUHAVEN_ESCROW_ADDRESS=

# ── Wave 3.5 contract addresses (active hot path) ──────────────────────
# Source: deployments/arb-sepolia-v2.json (created by `pnpm run deploy:v2:testnet`).
# Per MIGRATION.md, Wave 3.5 ships a fresh InvestorRegistry — the frontend's
# single `investorRegistry` slot points at the new one.
VITE_INVESTOR_REGISTRY_ADDRESS=

# Wave 3.5 platform contracts
VITE_SUBSCRIPTION_ADDRESS=
VITE_TOKEN_REGISTRY_ADDRESS=
VITE_IDENTITY_REGISTRY_ADDRESS=
VITE_MODULAR_COMPLIANCE_ADDRESS=
VITE_MUHAVEN_STABLE_ADDRESS=

# Active oracle pointer. IssuerControlledOracle is the default for Wave 3.5
# (immediate seed, no DON dependency). Swap to ChainlinkFunctionsOracle by
# updating both this slot AND TokenRegistry.setOracle on-chain in lockstep.
VITE_ORACLE_ADDRESS=

# ── Per-token routing (Wave 3.5 multi-token) ───────────────────────────
# JSON map { "0xTokenAddrLowercase": "0xSlotAddr" } per slot. Token
# addresses come from deployments/arb-sepolia-v2.json under
# tokens.{symbol}.contracts. Map keys MUST be lowercase per addresses.ts.
# YieldSnapshot is shared across tokens — every entry in
# VITE_YIELD_SNAPSHOTS_JSON points to the same proxy.
VITE_TREASURIES_JSON=
VITE_QUEUES_JSON=
VITE_YIELD_SNAPSHOTS_JSON=

# Singleton fallback for the per-token map above. Used as the YieldSnapshot
# proxy for any token not present in VITE_YIELD_SNAPSHOTS_JSON (Phase 9.A · F2
# wizard-deployed RWA tokens). The Wave 3.5 deployment uses ONE shared
# YieldSnapshot proxy across every token, so the singleton fallback is
# structurally correct. Without this, /distribute throws "No YieldSnapshot
# proxy configured for token 0x…" for any wizard-deployed token, and
# /yields silently skips its epochs.
VITE_YIELD_SNAPSHOT_ADDRESS=

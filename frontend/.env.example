# frontend/.env — production frontend build / dev.
#
# Usage:
#   cp frontend/.env.example frontend/.env
#   # then for local dev: bun run dev (vite default mode reads .env)
#   # or for the prod build: bun run build → ../muhaven-web
#
# The real .env is gitignored (see root .gitignore). Same key set as
# .env.stage.example — keep them in lockstep when adding a new key.
#
# Contract addresses pre-filled from deployments/arb-sepolia-v2.json
# (prod platform deploy 2026-05-04). Per-token JSON maps stay empty
# until tokens are onboarded — fill them after running
# `MUHAVEN_TOKEN_SYMBOL=… pnpm run onboard-token:testnet`.

# ── ZeroDev — smart account + passkey auth (Arbitrum Sepolia) ──────────
# Get these from https://dashboard.zerodev.app
# Bundler URL includes chain ID suffix — copy the full URL from dashboard.
# Domain field in the dashboard MUST be `https://muhaven.hasto.dev` (full
# URL, not bare hostname — see memory feedback_zerodev_domain_https_prefix).
VITE_ZERODEV_BUNDLER_URL=<<FILL_PROD_ZERODEV_BUNDLER_URL>>
VITE_ZERODEV_PASSKEY_SERVER_URL=<<FILL_PROD_ZERODEV_PASSKEY_SERVER_URL>>

# ── Backend API base URL ───────────────────────────────────────────────
VITE_API_BASE_URL=https://nagreg.hasto.dev/api/v1

# ── Chain ──────────────────────────────────────────────────────────────
VITE_CHAIN_ID=421614
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional — session-key TTL (seconds). Default 3600.
# VITE_SESSION_KEY_DURATION_SEC=3600

# ── Wave 3 contract addresses (read-only legacy view paths) ────────────
# Source: deployments/arb-sepolia.json. Wave 3 escrow flow is retired in
# Wave 3.5 but a few legacy view paths still resolve through these slots.
VITE_MUHAVEN_TOKEN_ADDRESS=0xF95c9aA19e974e4cA0778AAdb76580423eEEeb03
VITE_MUHAVEN_VAULT_ADDRESS=0xF445898f1af1DFde88E26c75C4d35c9025C5C631
VITE_YIELD_DISTRIBUTOR_ADDRESS=0xD403252436e41EFd81D76eB9223485cB66cb1638
VITE_KYC_ADAPTER_ADDRESS=0x0aF7003E645b3f8028dac59556aa0Cf0AeA21851
VITE_RISK_PARAMS_ADDRESS=0x7F287982232De3C78c1958Aa11f3D9826B445604
VITE_YIELD_GATE_ADDRESS=0x2cBAa54E5Ce4ED6D68722e35E18eba77B1c11964
VITE_MUHAVEN_ESCROW_ADDRESS=0xb18ca2122b31Df9Aaef8226f6218Bd93B852F40A

# ── Wave 3.5 contract addresses (active hot path) ──────────────────────
# Source: deployments/arb-sepolia-v2.json (prod platform deploy 2026-05-04).
# Per MIGRATION.md, Wave 3.5 ships a fresh InvestorRegistry — the
# frontend's single `investorRegistry` slot points at the new one.
VITE_INVESTOR_REGISTRY_ADDRESS=0xE7D4CB42EdB19e268e5e8a10d1A02f321Bfa50D0

# Wave 3.5 platform contracts
VITE_SUBSCRIPTION_ADDRESS=0x39D49B2614d24ba189B613bEAa903d829A73eA9e
VITE_TOKEN_REGISTRY_ADDRESS=0x4915E9Aa034244e299fb1609792D66b9fFAbf885
VITE_IDENTITY_REGISTRY_ADDRESS=0xD9Ab61fdED044bcBeB9eF687C357A35B5E7E9fAD
VITE_MODULAR_COMPLIANCE_ADDRESS=0x9A190A310C23FcF9Cd6c5Eab26Eb624B89e4D07a
VITE_MUHAVEN_STABLE_ADDRESS=0xF9bc25b67238C870255c33EC75fA37A09C00edE7

# Active oracle pointer. IssuerControlledOracle is the default for Wave 3.5
# (immediate seed, no DON dependency). Swap to ChainlinkFunctionsOracle
# (deployed at 0x6a480c6F7553098f7B9b0b285EcB7207a93feC43) by updating
# both this slot AND TokenRegistry.setOracle on-chain in lockstep.
VITE_ORACLE_ADDRESS=0xD30069114dFC83C714B04d6036dEfa64d2E9d583

# Singleton fallback for the per-token map below. The Wave 3.5 deployment
# uses ONE shared YieldSnapshot proxy across every RWA token, so the
# fallback is structurally correct. Without this, /distribute throws
# "No YieldSnapshot proxy configured for token 0x…" for any wizard-
# deployed (F2 self-serve onboarding) token, and /yields silently skips
# its epochs.
VITE_YIELD_SNAPSHOT_ADDRESS=0xaC4163f84db2C85333D5aF6f87848d7362A59887

# ── Per-token routing (Wave 3.5 multi-token) ───────────────────────────
# JSON map { "0xTokenAddrLowercase": "0xSlotAddr" } per slot. Token
# addresses come from deployments/arb-sepolia-v2.json under
# tokens.{symbol}.contracts. Map keys MUST be lowercase per addresses.ts.
# YieldSnapshot is shared across tokens — every entry in
# VITE_YIELD_SNAPSHOTS_JSON points to the same proxy
# (0xaC4163f84db2C85333D5aF6f87848d7362A59887).
#
# Empty `{}` is fine before tokens are onboarded — the singleton fallback
# (VITE_YIELD_SNAPSHOT_ADDRESS) covers /distribute + /yields. Fill these
# AFTER `pnpm run onboard-token:testnet` for each token, copying the
# resulting tokens.{symbol}.contracts entries.
VITE_TREASURIES_JSON={}
VITE_QUEUES_JSON={}
VITE_YIELD_SNAPSHOTS_JSON={}

# frontend/.env.stage — template for the staging frontend build / dev.
#
# Usage:
#   cp frontend/.env.stage.example frontend/.env.stage
#   # then for local dev: bun run dev:stage  (vite --mode stage on localhost:7778)
#   # or for the homelab build: bun run build:stage → ../muhaven-web-stage
#
# The real .env.stage is gitignored (see root .gitignore) for parity with
# backend/.env.stage — no secrets live here (all values are public client
# state), but the example-file pattern keeps the four env files uniform.
#
# Same key set and ordering as .env.example.

# ZeroDev — smart account + passkey auth (Arbitrum Sepolia)
# Intentionally NOT defined here — Vite merges .env then .env.stage, and an
# empty value here would override .env's ZeroDev URLs with an empty string
# (breaking passkey auth). Omitting the keys entirely lets the values from
# .env pass through. Uncomment + set only if staging should use a DIFFERENT
# ZeroDev project than prod.
VITE_ZERODEV_BUNDLER_URL=
VITE_ZERODEV_PASSKEY_SERVER_URL=

# Backend API base URL
VITE_API_BASE_URL=https://nagreg-stage.hasto.dev/api/v1

# Chain
VITE_CHAIN_ID=421614
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Wave 3 contract addresses (read-only legacy view paths) ────────────
# Source: deployments/arb-sepolia.staging.json
# These remain wired so the legacy Yields page can still render Wave 3
# distributions per MIGRATION.md "What lives, what dies" §"Wave 3 backend".
VITE_MUHAVEN_TOKEN_ADDRESS=0x886534eCf78922185e8DE6e70D2EfC55Ee4dBEA9
VITE_MUHAVEN_VAULT_ADDRESS=0x04870D3806C589c065F8e37557fAB5D689B872AD
VITE_YIELD_DISTRIBUTOR_ADDRESS=0x5BcbCC52F5ca445bC13c311FC544fdBA77db944f
VITE_KYC_ADAPTER_ADDRESS=0x02Fd3E06c6b1FD849ec94F456a67d1852f2b2a56
VITE_RISK_PARAMS_ADDRESS=0xD2586C6891e965158072C36fAeB0b00d212f67B8
VITE_YIELD_GATE_ADDRESS=0x9165104828f252Fc7F9277F21D59E78BA0827505
VITE_MUHAVEN_ESCROW_ADDRESS=0xafBfcF26f9951F793647B2628013B2cA0bA6F94D

# ── Wave 3.5 contract addresses (active hot path) ──────────────────────
# Source: deployments/arb-sepolia-v2.staging.json
# Per MIGRATION.md, Wave 3.5 ships a fresh InvestorRegistry — the frontend's
# single `investorRegistry` slot points at the new one (the Wave 3 registry
# stays callable on its own proxy, but the frontend has no read path that
# distinguishes the two).
VITE_INVESTOR_REGISTRY_ADDRESS=0x1F4BD727ea4De31C76943D66F198536b3fC1d9E4

# Wave 3.5 platform contracts
VITE_SUBSCRIPTION_ADDRESS=0x094F6eb63a9A8788697BBCA0589c1A285DD1e03A
VITE_TOKEN_REGISTRY_ADDRESS=0x9079E96DF0e1Ea1028d8809D8Ce083d5e912f219
VITE_IDENTITY_REGISTRY_ADDRESS=0x968Fa8D6e4D2c7aEeE98BB56475a72Dd72fda399
VITE_MODULAR_COMPLIANCE_ADDRESS=0xC8B2FD6A690815AD49F448Ea4789fF1BD81002Ca
VITE_MUHAVEN_STABLE_ADDRESS=0xf7f6Db67E06923f458F8a465160f53b2486F77Fd

# Active oracle pointer. IssuerControlledOracle is registered as the active
# oracle for both TBILL1 and GOLD1 in TokenRegistry today (immediate seed,
# no DON dependency). ChainlinkFunctionsOracle is deployed separately at
# 0xF9908091855A500CE67A7Cb10992f56571096A32 and per-token configured —
# swap via TokenRegistry.setOracle once DON fulfilment is verified.
VITE_ORACLE_ADDRESS=0xdD945eAbc3f708d31bA00DD0b384B04F35c53D2A

# ── Per-token routing (Wave 3.5 multi-token) ───────────────────────────
# JSON map { "0xTokenAddr": "0xSlotAddr" } per slot. Token addresses come
# from deployments/arb-sepolia-v2.staging.json under tokens.{symbol}.contracts.
# YieldSnapshot is shared across all tokens — every entry in
# VITE_YIELD_SNAPSHOTS_JSON points to the same proxy.
#
# Token addresses (lowercase as JSON keys per addresses.ts):
#   TBILL1: 0x3e570bdb3928488b0092fbe149d4b7e8d12cb178
#   GOLD1:  0x4963e942a846e7f537358fe0cc18c7aa9b554375
VITE_TREASURIES_JSON={"0x3e570bdb3928488b0092fbe149d4b7e8d12cb178":"0x4B35A182d502cfebAe9fabF9e8A25D80A3AA9B52","0x4963e942a846e7f537358fe0cc18c7aa9b554375":"0xe4320790833042b43A61CEff05a604D6CB2C195b"}
VITE_QUEUES_JSON={"0x3e570bdb3928488b0092fbe149d4b7e8d12cb178":"0xcD934a65bFe6C920b15cE3d4e65f7EF0662322Ed","0x4963e942a846e7f537358fe0cc18c7aa9b554375":"0x791e2736Bb9f11114E36B40836f7Bd4666f93fA5"}
VITE_YIELD_SNAPSHOTS_JSON={"0x3e570bdb3928488b0092fbe149d4b7e8d12cb178":"0x6d5C0E40f53c702CDc4923acccbdD6F45cBD3E29","0x4963e942a846e7f537358fe0cc18c7aa9b554375":"0x6d5C0E40f53c702CDc4923acccbdD6F45cBD3E29"}

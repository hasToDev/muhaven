# Loaded by Vite when building with `bun run build:stage` (mode=staging).
# Overrides .env on top of the shared VITE_ZERODEV_* values inherited from .env
# (which is gitignored and kept on the dev machine).
#
# This file IS committed — client-side values only, no secrets.
#
# After running `pnpm run deploy:testnet:stage` from the repo root, copy the
# addresses from deployments/arb-sepolia.staging.json into the VITE_* slots
# below.

VITE_API_BASE_URL=https://nagreg-stage.hasto.dev/api/v1
VITE_CHAIN_ID=421614

# Staging contract addresses (Arb Sepolia).
# Leave blank to fall back to the hard-coded prod addresses in
# src/contracts/addresses.ts — useful for UI-only changes that don't need a
# separate contract deployment.
VITE_MUHAVEN_TOKEN_ADDRESS=
VITE_MUHAVEN_VAULT_ADDRESS=
VITE_INVESTOR_REGISTRY_ADDRESS=
VITE_YIELD_DISTRIBUTOR_ADDRESS=
VITE_KYC_ADAPTER_ADDRESS=
VITE_RISK_PARAMS_ADDRESS=
VITE_YIELD_GATE_ADDRESS=
VITE_MUHAVEN_ESCROW_ADDRESS=

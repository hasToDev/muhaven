# Staging environment — loaded by Vite when building with
# `bun run build:stage` (mode=staging). Committed on purpose — client-side
# values only, no secrets. Same key set and ordering as .env.example.

# ZeroDev — smart account + passkey auth (Arbitrum Sepolia)
# Leave blank to inherit from .env on the build machine (same ZeroDev project
# as prod by default). Set explicit values here to route staging through a
# separate ZeroDev project.
VITE_ZERODEV_BUNDLER_URL=
VITE_ZERODEV_PASSKEY_SERVER_URL=

# Backend API base URL
VITE_API_BASE_URL=https://nagreg-stage.hasto.dev/api/v1

# Chain
VITE_CHAIN_ID=421614

# MuHaven contract addresses (staging deploy on Arb Sepolia).
# Source: deployments/arb-sepolia.staging.json
VITE_MUHAVEN_TOKEN_ADDRESS=0x886534eCf78922185e8DE6e70D2EfC55Ee4dBEA9
VITE_MUHAVEN_VAULT_ADDRESS=0x04870D3806C589c065F8e37557fAB5D689B872AD
VITE_INVESTOR_REGISTRY_ADDRESS=0x61186CD2c3b6B0DD6b9d92fe5D4eD154460F7fb2
VITE_YIELD_DISTRIBUTOR_ADDRESS=0x5BcbCC52F5ca445bC13c311FC544fdBA77db944f
VITE_KYC_ADAPTER_ADDRESS=0x02Fd3E06c6b1FD849ec94F456a67d1852f2b2a56
VITE_RISK_PARAMS_ADDRESS=0xD2586C6891e965158072C36fAeB0b00d212f67B8
VITE_YIELD_GATE_ADDRESS=0x9165104828f252Fc7F9277F21D59E78BA0827505
VITE_MUHAVEN_ESCROW_ADDRESS=0xafBfcF26f9951F793647B2628013B2cA0bA6F94D

PRIVATE_KEY=                  # Deployer wallet private key
ARB_SEPOLIA_RPC_URL=          # Arbitrum Sepolia RPC URL
BASE_SEPOLIA_RPC_URL=         # Base Sepolia RPC URL (optional)
FHENIX_API_KEY=               # Fhenix CoFHE API key
REINEIRA_API_KEY=             # ReineiraOS key
ETHERSCAN_API_KEY=            # Etherscan API key (for verification)
ARBISCAN_API_KEY=             # Arbiscan API key (for verification)
BASESCAN_API_KEY=             # Basescan API key (for verification, optional)

# NAV Worker
FRED_API_KEY=                 # FRED API key (free: https://fred.stlouisfed.org/docs/api/api_key.html)
NAV_FETCH_INTERVAL_MS=3600000 # NAV fetch interval in ms (default: 1 hour)
ETH_MAINNET_RPC_URL=          # Ethereum mainnet RPC (optional — defaults to free public RPC)
ARB_RPC_URL=                  # Arbitrum One RPC (optional — defaults to free public RPC)

# Deploy script variables (testnet only — local uses auto-deployed mocks)
ISSUER_ADDRESS=               # Address to grant minter + distribution rights (default: deployer)
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d   # Circle USDC on Arb Sepolia
UNDERLYING_TOKEN_ADDRESS=     # ERC-20 RWA token address for MuHavenVault (required on testnet)
REINEIRA_ESCROW_ADDRESS=0xC4333F84F5034D8691CB95f068def2e3B6DC60Fa  # ConfidentialEscrow proxy
PUSDC_ADDRESS=0x6b6e6479b8b3237933c3ab9d8be969862d4ed89f             # ConfidentialUSDC (no proxy)
SIMPLE_CONDITION_ADDRESS=0x9817DA50DB5CE4316D2f0fF6bb6DBfe252C29593  # SimpleCondition resolver

DB_PASSWORD=

# ── Wave 3.5 Phase 8 — platform deploy (deploy-v2.ts) ───────────────────
# Required after manual setup on https://functions.chain.link Arb Sepolia
# dashboard. Subscription ID is the numeric value shown next to the
# subscription name. Funded with testnet LINK from https://faucets.chain.link.
CHAINLINK_FUNCTIONS_SUBSCRIPTION_ID=

# Optional overrides (defaults are the canonical Arb Sepolia constants).
# Leave blank to use the script defaults — these are only here for the
# rare case Chainlink rotates the router or DON ID.
CHAINLINK_FUNCTIONS_ROUTER=
CHAINLINK_FUNCTIONS_DON_ID=

# Optional. If unset, deploy-v2.ts reads the Wave 3 ERC3643KYCAdapter
# from deployments/arb-sepolia[.staging].json. Override here if you need
# a fresh adapter (rare — MIGRATION.md prefers reuse).
KYC_ADAPTER_ADDRESS=

# ── Wave 3.5 Phase 8 — per-token onboarding (onboard-token.ts) ──────────
# These vary per token. Either edit them between TBILL1 / GOLD1 runs, or
# use the per-token env helpers in scripts/env/ (see HOMELAB_DEPLOY notes).
#
# IMPORTANT: TREASURY_SEED is the ONLY value here that consumes real USDC.
# Default is 0 — skip the seed entirely; treasury fills from investor
# purchases. The other values are pure config (stored on-chain as
# numbers, no funds moved).
MUHAVEN_TOKEN_SYMBOL=
MUHAVEN_TOKEN_NAME=
MUHAVEN_NAV_INITIAL=             # PUSDC base units per share (6 decimals)
MUHAVEN_TREASURY_SEED=0          # PUSDC base units (6 decimals). 0 = skip
MUHAVEN_MIN_INVESTMENT=1         # cleartext min shares per purchase
MUHAVEN_INSTANT_CAP=100000       # PUSDC base units. 100_000 = 0.1 USDC
MUHAVEN_EPOCH_DURATION=86400     # seconds (default: 1 day)
MUHAVEN_TREASURY_MIN_FLOAT=0     # cleartext minFloat for the solvency gate
MUHAVEN_MAX_DEVIATION_BPS=250    # 2.5% (use 500 for GOLD1 — gold is volatile)
MUHAVEN_MAX_STALENESS=           # seconds; blank = contract default 36h
MUHAVEN_PAUSED=                  # "true" to register paused
MUHAVEN_ORACLE_KIND=issuer       # "issuer" (immediate seed) or "chainlink"
MUHAVEN_ISSUER=                  # issuer EOA (default: deployer)
MUHAVEN_NAV_WRITER=              # NAV writer hot key — REQUIRED (2026-05-17 Design A).
                                 # Set to the platform's NAV-publisher signer (currently the deployer
                                 # 0xe11E...6986 on prod; rotate to a dedicated EOA pre-mainnet). The
                                 # onboard-token.ts script now hard-fails if this is unset to prevent
                                 # accidentally registering tokens with issuer-controlled navWriters,
                                 # which would re-introduce the stale-oracle problem Design A solves.
MUHAVEN_NAV_REQUESTER=           # Chainlink NAV requester (default: issuer)
MUHAVEN_CHAINLINK_CBOR=          # hex CBOR for Functions request (chainlink kind only)
MUHAVEN_CHAINLINK_GAS_LIMIT=300000

# ── Wave 3.5 Phase 8 — bulk-import-whitelist.ts ─────────────────────────
WAVE3_KYC_ADAPTER=               # blank = read from Wave 3 deploy file
WAVE3_KYC_FROM_BLOCK=            # blank = auto-discover via binary search + cache
WAVE3_KYC_BATCH_SIZE=200         # addresses per addWhitelisted call
WAVE3_KYC_LOG_CHUNK=50000        # eth_getLogs chunk size in blocks
WAVE3_KYC_DRY_RUN=               # "true" to inspect without sending tx
{
  "name": "@muhaven/sdk",
  "version": "0.1.0",
  "description": "MuHaven SDK — batch FHE encryption and two-phase yield distribution orchestration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cofhe/sdk": "^0.4.0"
  },
  "peerDependencies": {
    "viem": "^2.47.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "viem": "^2.47.12"
  },
  "keywords": [
    "fhe",
    "fhenix",
    "cofhe",
    "muhaven",
    "yield-distribution"
  ],
  "license": "MIT"
}

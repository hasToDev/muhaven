# nav-worker/.env.stage — template for the staging NAV worker service.
#
# Usage:
#   cp nav-worker/.env.stage.example nav-worker/.env.stage
#   # edit nav-worker/.env.stage, filling the <<FILL_*>> placeholder
#   scp nav-worker/.env.stage muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven-stage/nav-worker/.env.stage
#
# DATABASE_URL is injected by docker-compose.stage.yml — intentionally omitted
# here (matches prod's nav-worker/.env convention).

# In-container port. Host-side port (4002) is set in docker-compose.stage.yml —
# each compose stack runs on its own docker network, so internal ports can
# match prod without conflict.
PORT=3002

# Fetch interval in milliseconds (default: 1 hour)
NAV_FETCH_INTERVAL_MS=3600000

# FRED API key — free registration at https://fred.stlouisfed.org/docs/api/api_key.html
# Safe to reuse the prod key (combined ≈ 48 calls/day).
FRED_API_KEY=<<FILL_FRED_API_KEY>>

# On-chain RPC endpoints (optional — defaults to free public RPCs)
ETH_MAINNET_RPC_URL=
ARB_RPC_URL=

# ── Wave 3.5 token addresses (override the staging defaults baked in ──
# nav-worker/src/engine.ts STAGING_TBILL1 / STAGING_GOLD1).
#
# CRITICAL: rotate these on every staging redeploy. The 2026-05-08 staging
# redeploy rotated TBILL1 + GOLD1 addresses, and prod's nav-worker container
# (built before that rotation) silently wrote NAV rows for the OLD staging
# addresses for a week because these were left blank. Empty values silently
# fall back to whatever was hardcoded at image-build time.
#
# Source: `deployments/arb-sepolia-v2.staging.json` under
# `tokens.{SYMBOL}.contracts.MuHavenToken.proxy`.
NAV_TBILL1_ADDRESS=0xe80a64C13759e9b823265e2691c7C481EaAaf6e2
NAV_GOLD1_ADDRESS=0x80327c5D46c2c4C517B5f021f69cA7667f30b270

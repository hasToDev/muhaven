# NAV Worker environment variables
DATABASE_URL=postgresql://muhaven:muhaven@localhost:5432/muhaven
PORT=3002

# Fetch interval in milliseconds (default: 1 hour)
NAV_FETCH_INTERVAL_MS=3600000

# FRED API key — free registration at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# On-chain RPC endpoints (optional — defaults to free public RPCs)
ETH_MAINNET_RPC_URL=
ARB_RPC_URL=

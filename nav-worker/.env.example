# NAV Worker environment variables
DATABASE_URL=postgresql://muhaven:muhaven@localhost:5432/muhaven
PORT=3002

# Fetch interval in milliseconds (default: 1 hour)
NAV_FETCH_INTERVAL_MS=3600000

# FRED API key — free registration at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# On-chain RPC endpoints (optional — defaults to free public RPCs)
ETH_MAINNET_RPC_URL=
ARB_RPC_URL=

# ── RWA token addresses the worker fetches NAV for ─────────────────────
# REQUIRED in every environment (dev, staging, prod). As of 2026-05-12,
# `nav-worker/src/engine.ts` throws at module load if either value is
# missing or zero-address — Docker's restart policy surfaces the
# misconfiguration as a crash-loop instead of letting the worker
# silently write NAV rows to dead addresses (the 2026-05-11 prod
# incident: env_file edited but container restarted via
# `docker compose restart`, which does NOT pick up env_file changes).
# Get current values from `deployments/arb-sepolia-v2.json` under
# `tokens.{SYMBOL}.contracts.MuHavenToken.proxy`.
#
# When rotating these (e.g. after `pnpm run deploy:v2:testnet`), restart
# the container with `docker compose up -d --force-recreate nav-worker`,
# NOT `docker compose restart`.
NAV_TBILL1_ADDRESS=0x8D77cCf0a3a56c976a7DEAe59aF1D27f27407b0D
NAV_GOLD1_ADDRESS=0x93e813e924A96441181A01171Cd1E20FaaC87AcF

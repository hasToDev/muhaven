# nav-publisher/.env — local-dev template.
#
# Reads the latest token_nav_history row from Postgres and refreshes the
# on-chain IssuerControlledOracle.updatedAt for every onboarded token, so
# Subscription/RedemptionQueue/Treasury calls don't revert StaleNAV().

# In-container port (host port set in docker-compose.yml)
PORT=3003

DATABASE_URL=postgresql://muhaven:muhaven@localhost:5432/muhaven

# Publish cadence in milliseconds. Default 9h = IssuerControlledOracle's
# DEFAULT_MAX_STALENESS (36h) divided by 4. Lower for faster recovery
# from missed cycles; higher to save gas on quiet days.
NAV_PUBLISH_INTERVAL_MS=32400000

# Liveness gate: if the latest DB row for a token is older than this
# many milliseconds, the publisher SKIPS that token rather than refreshing
# stale data on-chain. Default 4× publish interval (36h with the default).
# Set to 0 to disable the gate entirely.
NAV_DB_LIVENESS_MS=129600000

# Per-token publish strategy. Comma-separated `SYMBOL_OR_ADDRESS=mode`
# pairs. Modes:
#   refresh-only  → re-write the existing on-chain NAV value (bumps
#                   updatedAt only). Safe default for par tokens (TBILL1)
#                   and demo-seeded price tokens (GOLD1).
#   skip          → never publish; token is handled by another oracle
#                   (e.g. ChainlinkFunctionsOracle).
# Tokens not listed default to NAV_PUBLISH_DEFAULT_STRATEGY below.
# Example: NAV_PUBLISH_STRATEGIES=TBILL1=refresh-only,GOLD1=refresh-only
NAV_PUBLISH_STRATEGIES=

# Default strategy for any token not enumerated in NAV_PUBLISH_STRATEGIES.
NAV_PUBLISH_DEFAULT_STRATEGY=refresh-only

# ── Chain config ──────────────────────────────────────────────────────────
# 421614 = Arb Sepolia (Wave 3.5). 42161 = Arb One (production).
CHAIN_ID=421614
ARB_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# IssuerControlledOracle proxy address (single oracle for all v3.5 tokens).
# Source: deployments/arb-sepolia-v2[.staging].json — contracts.IssuerControlledOracle.proxy
ORACLE_ADDRESS=

# Comma-separated list of token addresses to manage. Discovered from the
# DB at startup if left blank, but explicit listing is safer in prod.
# Example: NAV_PUBLISH_TOKENS=0x3E570bDb3928488b0092FBE149d4B7E8d12cb178,0x4963e942A846e7F537358fe0CC18C7aA9B554375
NAV_PUBLISH_TOKENS=

# Per-token symbol map for log readability. Same `SYMBOL=ADDRESS`
# convention as NAV_PUBLISH_STRATEGIES (key is the symbol). Address
# lookups fall back to a truncated 0xabcd…ef01 form when missing.
NAV_PUBLISH_TOKEN_SYMBOLS=

# Publisher signer private key. MUST equal getNavWriter(token) for every
# token managed by this service, OR each issuer must rotate to this key.
# Storage: keep out of source control. Production deployments should use
# a dedicated key (NOT the deployer key) with only navWriter rights.
NAV_PUBLISHER_PRIVATE_KEY=

# Send-tx tunables.
NAV_PUBLISH_TX_RETRIES=3
NAV_PUBLISH_TX_RETRY_DELAY_MS=2000
# Optional: cap on the number of retries that bump nonce + gasprice
# (vs simple replays). Defaults to NAV_PUBLISH_TX_RETRIES.
NAV_PUBLISH_TX_CONFIRM_TIMEOUT_MS=120000

# nav-publisher/.env — template for the production NAV publisher.
#
# Usage:
#   cp nav-publisher/.env.example nav-publisher/.env
#   # edit, filling the <<FILL_*>> placeholders
#   scp nav-publisher/.env muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven/nav-publisher/.env
#
# Reads the latest token_nav_history row from Postgres and refreshes the
# on-chain IssuerControlledOracle.updatedAt for every onboarded token, so
# Subscription/RedemptionQueue/Treasury calls don't revert StaleNAV().
#
# DATABASE_URL is injected by docker-compose.yml — intentionally omitted
# here (matches nav-worker convention).

# In-container port (host port set in docker-compose.yml).
PORT=3003

# 9h = DEFAULT_MAX_STALENESS (36h) / 4
NAV_PUBLISH_INTERVAL_MS=32400000

# Liveness gate: skip a token if its latest DB row is older than this many
# milliseconds (default 4× publish interval = 36h). Stops blind freshness
# pushes when upstream feeds (FRED) have gone silent. Set 0 to disable.
NAV_DB_LIVENESS_MS=129600000

# Per-token strategies. Both prod tokens currently use refresh-only —
# TBILL1 NAV stays at par (1e6 base units), GOLD1 stays at demo seed
# (1e4 base units). When a token rotates to NAVLink push, switch the
# entry to `skip` (or remove the line) so this service stops touching it.
NAV_PUBLISH_STRATEGIES=TBILL1=refresh-only,GOLD1=refresh-only
NAV_PUBLISH_DEFAULT_STRATEGY=refresh-only

# ── Chain config ──────────────────────────────────────────────────────────
# 421614 = Arb Sepolia (Wave 3.5). 42161 = Arb One (post-mainnet swap).
CHAIN_ID=421614
ARB_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Source: deployments/arb-sepolia-v2.json — contracts.IssuerControlledOracle.proxy
ORACLE_ADDRESS=0xD30069114dFC83C714B04d6036dEfa64d2E9d583

# Source: deployments/arb-sepolia-v2.json — contracts.TokenRegistry.proxy.
# REQUIRED (2026-05-17 Design A): the publisher enumerates active tokens
# from this registry at startup unless NAV_PUBLISH_TOKENS overrides.
TOKEN_REGISTRY_ADDRESS=0x4915E9Aa034244e299fb1609792D66b9fFAbf885

# NAV_PUBLISH_TOKENS / NAV_PUBLISH_TOKEN_SYMBOLS — OPTIONAL OVERRIDE
# (2026-05-17 Design A). Leave UNSET so the publisher enumerates the
# active roster from TokenRegistry on each restart. Set to a comma-list
# of token addresses for testing or sentinel exclusion (e.g. skip a
# problematic token while keeping the rest of the roster live).
# NAV_PUBLISH_TOKENS=0x8D77cCf0a3a56c976a7DEAe59aF1D27f27407b0D,0x93e813e924A96441181A01171Cd1E20FaaC87AcF
# NAV_PUBLISH_TOKEN_SYMBOLS=TBILL1=0x8D77cCf0a3a56c976a7DEAe59aF1D27f27407b0D,GOLD1=0x93e813e924A96441181A01171Cd1E20FaaC87AcF

# This key MUST equal IssuerControlledOracle.getNavWriter(token) for every
# managed token. Prod has the deployer key (0xe11E…6986) registered as the
# navWriter for both TBILL1 and GOLD1 (set at onboarding) — so reuse the
# deployer key here, OR rotate the navWriter via
# IssuerControlledOracle.setNavWriter (governance).
#
# Storage: keep out of source control. For a stricter posture, generate
# a dedicated key with only navWriter rights and rotate the on-chain
# navWriter to it before running this service.
NAV_PUBLISHER_PRIVATE_KEY=<<FILL_NAV_PUBLISHER_PRIVATE_KEY>>

# ── Send-tx tunables ──────────────────────────────────────────────────────
NAV_PUBLISH_TX_RETRIES=3
NAV_PUBLISH_TX_RETRY_DELAY_MS=2000
NAV_PUBLISH_TX_CONFIRM_TIMEOUT_MS=120000

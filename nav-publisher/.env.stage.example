# nav-publisher/.env.stage — template for the staging NAV publisher.
#
# Usage:
#   cp nav-publisher/.env.stage.example nav-publisher/.env.stage
#   # edit, filling the <<FILL_*>> placeholders
#   scp nav-publisher/.env.stage muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven-stage/nav-publisher/.env.stage
#
# DATABASE_URL is injected by docker-compose.stage.yml — intentionally
# omitted here (matches nav-worker convention).

# In-container port. Host-side port (4003) is set in docker-compose.stage.yml.
PORT=3003

# 9h = DEFAULT_MAX_STALENESS (36h) / 4
NAV_PUBLISH_INTERVAL_MS=32400000
# 4× publish interval — abandons publishing if upstream feeds went silent.
NAV_DB_LIVENESS_MS=129600000

# Per-token strategies. Both staging tokens currently use refresh-only —
# TBILL1 NAV stays at par (1e6 base units), GOLD1 stays at demo seed
# (1e4 base units). When a token rotates to NAVLink push, switch the
# entry to `skip` (or remove the line) so this service stops touching it.
NAV_PUBLISH_STRATEGIES=TBILL1=refresh-only,GOLD1=refresh-only
NAV_PUBLISH_DEFAULT_STRATEGY=refresh-only

# Arb Sepolia
CHAIN_ID=421614
ARB_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Source: deployments/arb-sepolia-v2.staging.json
# contracts.IssuerControlledOracle.proxy
ORACLE_ADDRESS=0xdD945eAbc3f708d31bA00DD0b384B04F35c53D2A

# Source: deployments/arb-sepolia-v2.staging.json — tokens.<SYMBOL>.contracts.MuHavenToken.proxy
NAV_PUBLISH_TOKENS=0x3E570bDb3928488b0092FBE149d4B7E8d12cb178,0x4963e942A846e7F537358fe0CC18C7aA9B554375
NAV_PUBLISH_TOKEN_SYMBOLS=TBILL1=0x3E570bDb3928488b0092FBE149d4B7E8d12cb178,GOLD1=0x4963e942A846e7F537358fe0CC18C7aA9B554375

# This key MUST be the registered navWriter for every onboarded token.
# Staging currently has the deployer key (0xe11E…6986) registered as the
# navWriter for both tokens — so reuse that key here, OR rotate the
# navWriter via IssuerControlledOracle.setNavWriter (governance).
NAV_PUBLISHER_PRIVATE_KEY=<<FILL_NAV_PUBLISHER_PRIVATE_KEY>>

# Send-tx tunables.
NAV_PUBLISH_TX_RETRIES=3
NAV_PUBLISH_TX_RETRY_DELAY_MS=2000
NAV_PUBLISH_TX_CONFIRM_TIMEOUT_MS=120000

# Make `pnpm run <script>` use pnpm's built-in POSIX shell emulator on every
# platform. Required so env-var prefixes in package.json scripts work on
# Windows (e.g. `MUHAVEN_ENV=staging hardhat run ...`), which Windows `cmd`
# otherwise rejects as an unknown command.
shell-emulator=true

# Quarantine freshly-published versions for 7 days before pnpm will resolve
# them, blocking the short detection window most npm supply-chain worms
# rely on (Shai-Hulud, Mini Shai-Hulud, etc.). Value is in MINUTES.
# Only affects NEW resolutions — anything already in pnpm-lock.yaml installs
# unchanged. Override on a one-shot install with
# `pnpm install --config.minimumReleaseAge=0 <pkg>` when an urgent fix can't
# wait, or extend `minimumReleaseAgeExclude` here for permanent exceptions.
# Mirrors bunfig.toml's `minimumReleaseAge` (seconds) at the repo root +
# frontend/.
minimumReleaseAge=10080

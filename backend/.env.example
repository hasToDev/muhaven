# backend/.env — template for the production backend service.
#
# Usage:
#   cp backend/.env.example backend/.env
#   # edit backend/.env, filling every <<FILL_*>> placeholder
#   scp backend/.env muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven/backend/.env
#
# The real .env is gitignored (see root .gitignore). Same key set as
# .env.stage.example — keep them in lockstep when adding a new key.
#
# Contract addresses pre-filled from deployments/arb-sepolia-v2.json
# (prod platform deploy 2026-05-04). Per-token JSON arrays stay empty
# until tokens are onboarded — fill them after running
# `MUHAVEN_TOKEN_SYMBOL=… pnpm run onboard-token:testnet`.

# ── Database ────────────────────────────────────────────────────────────────
# Password must match whatever DB_PASSWORD is set to on the homelab when
# bringing the stack up.
DB_PROVIDER=postgres
DATABASE_URL=postgresql://muhaven:<<FILL_PROD_DB_PASSWORD>>@postgres:5432/muhaven

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a fresh secret — do NOT reuse staging's. Command:
#   openssl rand -hex 32
JWT_SECRET=<<FILL_PROD_JWT_SECRET_64_HEX_CHARS>>
JWT_ISSUER=muhaven.xyz
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# ── Chain ───────────────────────────────────────────────────────────────────
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── CORS ────────────────────────────────────────────────────────────────────
# Production origin only. MUST NOT include stage.muhaven.app or
# pay-stage.muhaven.app.
#
# 2026-05-15 subdomain-collapse migration: buyer page now lives at
# `https://muhaven.app/pay/` (same origin as the dashboard), so the
# CORS allowlist only needs the apex. The legacy `pay.muhaven.app`
# origin is retained ONLY to serve the JS-redirect shim; it never
# POSTs to the backend.
ALLOWED_ORIGINS=http://localhost:7778,https://muhaven.app,https://pay.muhaven.app

# ── FHE Worker (internal compose DNS) ───────────────────────────────────────
FHE_WORKER_URL=http://fhe-worker:3001

# ── Wave 3 contract addresses (read-only legacy view + KYC admin) ──────────
# Source: deployments/arb-sepolia.json. KYC_ADAPTER_ADDRESS stays active
# because demo-mode self-serve whitelist still writes to the Wave 3 adapter
# for parity with the Wave 3 backend.
MUHAVEN_TOKEN_ADDRESS=0xF95c9aA19e974e4cA0778AAdb76580423eEEeb03
MUHAVEN_VAULT_ADDRESS=0xF445898f1af1DFde88E26c75C4d35c9025C5C631
INVESTOR_REGISTRY_ADDRESS=0xE7D4CB42EdB19e268e5e8a10d1A02f321Bfa50D0
YIELD_DISTRIBUTOR_ADDRESS=0xD403252436e41EFd81D76eB9223485cB66cb1638
KYC_ADAPTER_ADDRESS=0x0aF7003E645b3f8028dac59556aa0Cf0AeA21851
RISK_PARAMS_ADDRESS=0x7F287982232De3C78c1958Aa11f3D9826B445604
YIELD_GATE_ADDRESS=0x2cBAa54E5Ce4ED6D68722e35E18eba77B1c11964

# ── Wave 3.5 contract addresses (active hot path) ──────────────────────────
# Source: deployments/arb-sepolia-v2.json. INVESTOR_REGISTRY_ADDRESS above
# already swapped to the Wave 3.5 fresh-deploy registry per MIGRATION.md.
SUBSCRIPTION_ADDRESS=0x39D49B2614d24ba189B613bEAa903d829A73eA9e
STABLE_ADDRESS=0xF9bc25b67238C870255c33EC75fA37A09C00edE7
# Read by seed-tokens-v35 to discover registered tokens AND by the
# tax-event indexer (Phase 9.A · Expansion F1) to subscribe to
# `TokenRegistry.IssuerUpdated` events.
TOKEN_REGISTRY_ADDRESS=0x4915E9Aa034244e299fb1609792D66b9fFAbf885

# Active oracle for the issuer NAV endpoints + NAV writer cron.
# IssuerControlledOracle is the default for Wave 3.5 (immediate seed, no
# DON dependency). Swap to ChainlinkFunctionsOracle (deployed at
# 0x6a480c6F7553098f7B9b0b285EcB7207a93feC43) by updating both this slot
# AND TokenRegistry.setOracle on-chain in lockstep.
ORACLE_ADDRESS=0xD30069114dFC83C714B04d6036dEfa64d2E9d583

# Tax-event indexer scope (per ADR-020 / ADR-040). JSON arrays of per-token
# Wave 3.5 contract addresses; empty array disables that path. Source:
# arb-sepolia-v2.json under tokens.{symbol}.contracts. TBILL1 + GOLD1
# pre-filled below; add new tokens after running
# `bash scripts/onboard-token.sh <symbol>`.
REDEMPTION_QUEUE_ADDRESSES_JSON=["0x435aF5AF238aBe80DD4dc571C38C167F407c4E9c","0x6f2D952c0350BB0d5F856df5F7f534dEAD6634A7"]
# Wave 3.5 deploys ONE shared YieldSnapshot proxy across every token
# (vs the per-token Subscription / Queue / Treasury), so this array has
# a single entry even with multiple tokens onboarded.
YIELD_SNAPSHOT_ADDRESSES_JSON=["0xaC4163f84db2C85333D5aF6f87848d7362A59887"]
# Phase 9.A · Option Z follow-up — per-RWA MuHavenToken proxies. The
# indexer subscribes to broadened Transfer(from, to, amount) logs and
# inserts two tax_events rows per qualifying P2P transfer (sender +
# recipient). Source: tokens.{symbol}.contracts.MuHavenToken.proxy.
MUHAVEN_TOKEN_ADDRESSES_JSON=["0x8D77cCf0a3a56c976a7DEAe59aF1D27f27407b0D","0x93e813e924A96441181A01171Cd1E20FaaC87AcF"]
# Phase 9.A · Option Z follow-up — protocol filter: addresses whose
# Transfer participation should NOT surface as a P2P /activity row.
# Subscription + queues + snapshots above are auto-included by the
# indexer; this list adds the per-RWA Treasury proxies.
TREASURY_ADDRESSES_JSON=["0xf423CE2d1fD856F89Ca75ec47c2791CeD91D62a3","0x5057b445d7Ac1AFbd834122f63A9652DfCb78157"]

# Tax-event indexer cron — Phase 9.A · Option Z makes this the canonical
# source for the activity feed (Wave 3 yield + escrow paths retired).
TAX_EVENT_POLLER_ENABLED=true
TAX_EVENT_POLLER_INTERVAL_MS=15000

# NAV writer cron — calls oracle.requestNAV(token) once per
# NAV_CRON_INTERVAL_MS for every active token in `rwa_tokens`. Off by
# default — only useful when the active oracle is ChainlinkFunctionsOracle
# (requestNAV does not exist on the issuer-write IssuerControlledOracle).
# Re-enable after swapping ORACLE_ADDRESS to ChainlinkFunctionsOracle.
#
# IMPORTANT: NAV_CRON_PRIVATE_KEY MUST be either empty (cron stays idle)
# or a 0x-prefixed 32-byte hex string. A placeholder like "<<FILL_*>>" or
# any non-hex string crashes the backend on boot inside viem's
# privateKeyToAccount.
NAV_CRON_ENABLED=false
NAV_CRON_INTERVAL_MS=3600000
NAV_CRON_PRIVATE_KEY=

# ── ReineiraOS infrastructure (shared with staging — unchanged) ────────────
# REINEIRA_ESCROW_ADDRESS is a legacy env var name — points at the prod
# MuHavenEscrow proxy (Phase 19B replaced ReineiraOS ConfidentialEscrow).
PUSDC_ADDRESS=0x6b6e6479b8b3237933c3ab9d8be969862d4ed89f
REINEIRA_ESCROW_ADDRESS=0xb18ca2122b31Df9Aaef8226f6218Bd93B852F40A
SIMPLE_CONDITION_ADDRESS=0x9817DA50DB5CE4316D2f0fF6bb6DBfe252C29593
CIRCLE_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
REINEIRA_COORDINATOR_URL=https://dswtxw6k9mker.cloudfront.net

# ── Block event poller (Phase 19D) ──────────────────────────────────────────
# Phase 9.A · Option C / Option Z — Wave 3 yield + escrow paths retired.
# `/activity` reads from `tax_events` only; the legacy poller is a no-op
# on a Wave-3.5-only stack.
BLOCK_POLLER_ENABLED=false
BLOCK_POLLER_INTERVAL_MS=15000

# ── Demo-mode self-serve whitelist ──────────────────────────────────────────
# ERC3643KYCAdapter has a single admin slot set at deploy time = deployer.
# Leave blank to disable the endpoint entirely (returns 503).
DEMO_WHITELIST_PRIVATE_KEY=<<FILL_PROD_DEPLOYER_PRIVATE_KEY>>

# ── Webhooks (optional) ─────────────────────────────────────────────────────
QUICKNODE_WEBHOOK_SECRET=

# ── Phase 9.A · Expansion (F2) — self-serve issuer onboarding ──────────────
# Toggle + addresses + key for the `/v1/issuer/tokens/deploy` endpoint.
# When ISSUER_ONBOARDING_ENABLED=false (default) OR when any of the
# addresses + key below are missing, the deploy endpoint returns 503.
#
# PLATFORM_DEPLOYER_PRIVATE_KEY is the SAME EOA as the project root's
# PRIVATE_KEY (the platform deployer that owns TokenRegistry +
# InvestorRegistry + ModularCompliance + IssuerControlledOracle — every
# `onlyOwner`-gated call the deploy library makes). Using a fresh key
# requires `transferOwnership` on all four contracts first. Needs Arb
# Sepolia ETH (~0.005 ETH per deploy). Zero PUSDC float.
ISSUER_ONBOARDING_ENABLED=true
PLATFORM_DEPLOYER_PRIVATE_KEY=<<FILL_SAME_AS_ROOT_DOTENV_PRIVATE_KEY>>
# Source: deployments/arb-sepolia-v2.json
INVESTOR_REGISTRY_V35_ADDRESS=0xE7D4CB42EdB19e268e5e8a10d1A02f321Bfa50D0
YIELD_SNAPSHOT_ADDRESS=0xaC4163f84db2C85333D5aF6f87848d7362A59887
IDENTITY_REGISTRY_ADDRESS=0xD9Ab61fdED044bcBeB9eF687C357A35B5E7E9fAD
MODULAR_COMPLIANCE_ADDRESS=0x9A190A310C23FcF9Cd6c5Eab26Eb624B89e4D07a
ISSUER_ORACLE_ADDRESS=0xD30069114dFC83C714B04d6036dEfa64d2E9d583
# 2026-05-17 Design A · PREVENTION — platform-managed NAV writer EOA.
# The address of the signer that publishes NAV on behalf of self-serve-
# onboarded tokens. The deploy library registers this address as
# `navWriter` for every new token (instead of the applicant's kernel),
# and the wizard step-6 setNAV call runs server-side via this signer
# (`IssuerOracleNavWriterService`). MUST equal the address derived from
# PLATFORM_DEPLOYER_PRIVATE_KEY — boot-time assert in the service refuses
# to construct otherwise. Today the platform deployer EOA on prod is
# 0xe11E...6986 (same signer as `nav-publisher`); rotate to a dedicated
# EOA pre-mainnet.
PLATFORM_NAV_WRITER_ADDRESS=<<FILL_WITH_ADDRESS_DERIVED_FROM_PLATFORM_DEPLOYER_PRIVATE_KEY>>
# Path inside the backend container where compiled contract artifacts
# (MuHavenToken / RedemptionQueue / MuHavenTreasury bytecode + ABI) are
# baked in. `scripts/deploy-homelab.sh` stages `artifacts/contracts/`
# into `backend/contracts-artifacts/contracts/` before docker build.
MUHAVEN_ARTIFACTS_DIR=/app/contracts-artifacts

# ── Wave 4 P2 — HavenBot LLM (Google Gemini) ──────────────────────────────
# When set, ChatLlmService routes the /api/v1/agent/chat/stream path through
# Google Gemini 2.0 Flash with function-calling for tool dispatch. When
# unset, the deterministic stub classifier fires instead. Production should
# set this to a paid Google Cloud Gemini key once the chat surface is
# promoted to GA in Wave 5.
GEMINI_API_KEY=
# Optional model override — defaults to `gemini-2.5-flash` (current
# Flash tier; `gemini-2.0-flash` was retired for new keys 2026-05-09).
# GEMINI_MODEL=gemini-2.5-flash

# ── Wave 4 P4 / P7 — OpenClaw / Telegram surface ────────────────────────────
# Backend reads four user-set + one internal-DNS Telegram env vars. ALL
# are optional at the schema level (zod `.optional()` in
# `backend/src/core/config.ts`); leaving the block empty disables the
# Telegram integration end-to-end (worker-shaped routes 503, Mini App
# initData verifier never builds, deep-link renderer falls back to a
# generic "configure your bot" string).
#
# These MUST mirror the values in `telegram-bot/.env` — the worker and
# the backend share the bot token (Mini App initData HMAC) and the
# service secret (worker→backend authentication).
#
# When the integration IS enabled, populate ALL of these in lockstep —
# a half-configured backend (e.g. token but no service secret) leaves
# the worker-shaped routes accepting unauthenticated calls and is the
# wrong failure mode.

# Service-to-service secret presented by the `telegram-bot/` worker on
# every call into the backend's `/api/v1/agent/openclaw/*` worker-shaped
# routes. Same value the worker reads from TELEGRAM_BOT_SERVICE_SECRET in
# its own .env. Schema enforces ≥16 chars in the middleware; production
# convention is 32+ (matches the worker's enforcement floor).
TELEGRAM_BOT_SERVICE_SECRET=<<FILL_PROD_SERVICE_SECRET_64_HEX_CHARS>>

# Bot token from @BotFather. Used by the backend ONLY to verify Mini App
# initData HMACs (per Telegram's WebApp protocol — the HMAC key is
# derived from the bot token). MUST be byte-identical to the worker's
# TELEGRAM_BOT_TOKEN; a divergence means valid Mini App requests fail
# initData verification.
TELEGRAM_BOT_TOKEN=<<FILL_PROD_BOTFATHER_TOKEN>>

# Bot username without leading `@`. Used by the backend's deeplink
# renderer to build `t.me/<username>?start=<linkCode>` strings surfaced
# to the dashboard `/agent` Telegram-link tab.
TELEGRAM_BOT_USERNAME=<<FILL_PROD_BOT_USERNAME>>

# Public Mini App URL (the `web_app` button on the mid-tier inline
# keyboard, $200–$5K). Mirror the worker's TELEGRAM_MINI_APP_URL — the
# backend embeds this string into the inline-keyboard payload it returns
# to the worker for the mid-tier confirmation surface.
TELEGRAM_MINI_APP_URL=https://muhaven.app/telegram-mini-app

# Wave 4 P7 — base URL of the running `telegram-bot/` worker so the
# backend can publish issuer-narrative broadcasts (distribution-funded /
# KYC-changed / token-unpaused) into the operator-curated public channel.
# Container name `telegram-bot` resolves inside the muhaven docker
# network; port 3004 matches the worker's PORT. When unset OR when the
# operator has deferred channel setup (TELEGRAM_ISSUER_CHANNEL_ID empty
# on the worker side), the use-case falls back to LoggingIssuerChannelTransport
# (events log + drop). Safe to leave commented until P7 channel ships.
# TELEGRAM_BOT_WORKER_URL=http://telegram-bot:3004

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=3000

# ── Wave 4 P5 — Hosted checkout (`muhaven.app/pay/`) ────────────────────
# Public base URL of the hosted-checkout buyer page. The backend's
# `POST /api/v1/checkout/sessions/create` use-case writes
# `<CHECKOUT_PUBLIC_URL>/c/<sessionId>#k=<fragmentKey>` into the
# response payload it returns to the issuer.
#
# 2026-05-15 subdomain-collapse: this used to be `https://pay.muhaven.app`.
# It now points at the apex with a `/pay` path prefix so the buyer-page
# origin matches the dashboard's. Same-origin = the dashboard's GPM-
# backed passkey credential is the buyer-page credential by
# construction, so Chrome on Windows offers GPM at the UserOp signing
# step instead of forcing Windows Hello (Plan C v1/v2 root cause).
#
# Default (when unset) is `http://localhost:7780` for local dev.
#
# Operator hosting model: the dist for `apps/checkout-pay/` is built
# into `muhaven-web/pay/` (a subdirectory of the dashboard's sibling
# GitHub repo). GitHub Pages serves both the dashboard at `/` and the
# buyer page at `/pay/`, with each surface's own `404.html` providing
# the SPA fallback for unknown sub-paths (nearest-up-the-tree rule).
# The legacy `muhaven-checkout-web` repo is retained — its contents
# are replaced with a JS-redirect shim so pre-migration URLs at
# `https://pay.muhaven.app/c/<id>#k=<key>` bounce to the new apex
# path with the fragment intact.
CHECKOUT_PUBLIC_URL=https://muhaven.app/pay

# ── Wave 5 Q1 — RWA oracle ingest (optional) ────────────────────────────
# Bearer secret the operator script (`backend/scripts/ingest-oracle.ts`)
# presents on `POST /api/v1/oracle/ingest` when uploading per-token
# rwa.xyz scrape payloads. When unset, the route returns 503 for ALL
# callers; when set wrong, 401. The endpoint is NOT user-facing —
# operator runs the ingest from a dev machine. Mirrors the
# `TELEGRAM_BOT_SERVICE_SECRET` pattern (≥16 chars enforced by the
# `withServiceSecret` middleware; we generate 32 random bytes hex).
# Generate:
#   openssl rand -hex 32
# Store in your password manager; never commit. MUST differ from
# `OPERATOR_ALERT_TEST_SECRET` below — the config schema's
# superRefine refuses boot if they're equal.
# ORACLE_INGEST_SERVICE_SECRET=replace-with-32-random-bytes-hex

# ── Wave 5 Q3 step 3 — operator-alert surface (optional) ────────────────
# Single recipient chat id the backend forwards yield-cron failure
# alerts to via the telegram-bot worker. When unset, the container
# falls back to LoggingOperatorAlertTransport (alerts log + drop —
# safe degraded mode). To activate the HTTP transport, ALL THREE of
# TELEGRAM_BOT_WORKER_URL + TELEGRAM_BOT_SERVICE_SECRET +
# OPERATOR_TELEGRAM_CHAT_ID must be set. The telegram-bot worker also
# pins its own OPERATOR_TELEGRAM_CHAT_ID and refuses to forward to any
# other chat (Security H-3 — defeats service-secret-leak abuse). Both
# env vars must agree numerically; the validator + worker both reject
# leading zeros ('00012345' and '12345' would lexical-compare-fail).
# To find your id: DM the bot then visit
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates — the
# `message.chat.id` field is your private-chat id. For supergroup
# routing use the -100… numeric id (every group member sees the
# alerts; recommend a private DM).
# OPERATOR_TELEGRAM_CHAT_ID=12345

# Bearer secret for `POST /api/v1/operator/alert-test` — the diagnostic
# route the operator curls after deploy to verify the alert chain
# (backend → bot → Telegram). When unset, the route returns 503 for
# all callers. MUST differ from ORACLE_INGEST_SERVICE_SECRET — the
# config schema's superRefine refuses boot if they're equal
# (blast-radius separation per Wave 5 Q3 plan A1). Generate as 32
# random bytes hex (≥16 chars enforced by schema):
#   openssl rand -hex 32
# Store in your password manager; never commit.
# OPERATOR_ALERT_TEST_SECRET=replace-with-32-random-bytes-hex

# ── Wave 5 Option D · Commit 1 — one-shot migration endpoint ────────────
# POST /api/v1/operator/option-d-c1-revoke-all-active-scoped-sessions
# Used by `scripts/sql/option-d-c1-migration.sh` to bulk-revoke pre-D1
# narrow-CallPolicy Scoped sessions immediately after the broadened
# CallPolicy ships. Dedicated env (NOT reused with the operator-alert
# or oracle-ingest secrets) — the config schema's superRefine refuses
# boot when this value collides with any of the other operator-facing
# secrets (blast-radius separation). Generate:
#   openssl rand -hex 32
# Rotate AFTER a successful run with revokedCount > 0 (SecEng-HIGH-3
# one-shot hygiene). Endpoint stays live indefinitely; rotate the
# secret to retire the surface until C6 removes the route.
# OPTION_D_C1_MIGRATION_SECRET=replace-with-32-random-bytes-hex

# ── Wave 5 Option D · Commit 2 — pgcrypto encrypt-at-rest key ───────────
# Symmetric key for `agent_scoped_sessions.enable_data` / `enable_sig`
# column-level encryption. 32 random bytes hex-encoded; backend reads
# it as the second argument to pgp_sym_encrypt / pgp_sym_decrypt.
#
# Required ONLY when the Scoped tier captures install material at mint
# (frontend ≥ 0.3.73). Pre-C2 mints continue to land with NULL
# enable_data / enable_sig and the encryption key can be left unset
# (the install-material subroute returns 503 in that case).
#
# Generate per-deploy:
#   openssl rand -hex 32
#
# Operator runbook AFTER initial provision:
#   1. SCP backend/.env to homelab.
#   2. `docker compose up -d --no-deps --force-recreate backend`
#      (plain restart does NOT re-read env_file — confirmed gotcha).
#   3. Verify pgcrypto extension installed (`bash scripts/sql/
#      install-pgcrypto-homelab.sh prod` is idempotent; the backend
#      boot path also runs CREATE EXTENSION IF NOT EXISTS).
#   4. Smoke a mint round-trip and re-curl the install-material
#      subroute — expect 200 with the original cleartext.
# OPTION_D_C2_ENCRYPTION_KEY=replace-with-32-random-bytes-hex

# Wave 5 Option D · Commit 2 — broker callback shared secret. Gates
# the install-material subroute (`GET /policy/scoped-session/
# :sessionId/install-material`) AND the C3 broker-callback route
# (`POST .../validator-enabled`). Held by the MCP server + broker
# daemon; never seen by browser clients. ≥16 chars. Generate:
#   openssl rand -hex 32
# Must differ from every other operator-facing secret (blast-radius
# separation, enforced via config-schema superRefine).
# BROKER_CALLBACK_SERVICE_SECRET=replace-with-32-random-bytes-hex

# ── Wave 5 Q3 step 4 — daily yield-distribution cron ────────────────────
# Drives the proportional yield-distribution pipeline (openEpoch →
# snapshotBatch → finalizeSnapshot → fundEpoch) for every active RWA
# at the configured cadence. OPT-IN — leave disabled until both the
# operator-alert env vars above are provisioned AND the issuer EOA
# holds a pre-wrapped mhUSDC float (Q3_PLAN.md A.5; operator runs
# `scripts/wrap-pusdc-only.ts` on a dev machine to seed ~30 days of
# buffer).
#
# Rollout (Q3_PLAN.md steps 5+6+7):
#   1. Provision env vars below with YIELD_CRON_DRY_RUN=true.
#   2. Set YIELD_CRON_ENABLED=true + restart backend container.
#      Confirm: a 6h-debounced "DRY-RUN" Telegram alert lands; cron
#      log shows token iteration without on-chain side effects.
#   3. After 24h smoke + manual `pnpm tsx scripts/run-daily-yield.ts
#      --dry-run --token=USYC --env=prod` returns expected
#      ratePerShare / encTotalYield magnitudes:
#      Flip YIELD_CRON_DRY_RUN=false + restart. Next midnight UTC
#      tick is the first live distribution.
#
# IMPORTANT: YIELD_CRON_PRIVATE_KEY MUST be either UNSET (cron stays
# idle even if YIELD_CRON_ENABLED=true) or a 0x-prefixed 32-byte hex
# string. The config schema regex-validates the shape — a placeholder
# like "<<FILL_*>>" boot-fails LOUD instead of silently producing a
# misconfigured Wallet inside viem. Often the SAME EOA as
# PLATFORM_DEPLOYER_PRIVATE_KEY above (cheapest path — already has
# issuer rights + already funded; rotate to a dedicated EOA pre-
# mainnet to narrow blast radius).

YIELD_CRON_ENABLED=false
YIELD_CRON_PRIVATE_KEY=
# Skip on-chain side effects + DB audit writes. Leave `true` for the
# 24h smoke window after first enabling the cron; flip to `false`
# only after the dry-run telemetry + manual one-off both look right.
YIELD_CRON_DRY_RUN=true

# ── Wave 5 Q3 step 4 — tuning knobs (all optional, defaults are safe) ───
# Cron expression — defaults to daily midnight UTC. The schema regex
# rejects sub-hourly forms (`* * * * *`, `0 * * * *`, step / list
# forms) at boot to prevent the cron from turning into a Postgres
# connection storm + alert spam under contention. Daily / multi-hour
# fixed-time schedules pass; anything sub-hourly is refused.
# YIELD_CRON_CRON_EXPR=0 0 * * *

# Global per-token effective overage cap, shares. Per-token override
# via `rwa_tokens.max_supply_cap_override` (operator-set raw SQL UPDATE;
# clamped to [1, this value] at READ time). The cron computes
# `encTotalYield = effectiveCap × ratePerShare / RATE_SCALE`; this is
# the issuer's deliberate overfunding budget per token-day. Excess
# mhUSDC stays in the YieldSnapshot proxy after `claimExpiry`. Bounded
# at config-parse time to [1, 10_000_000_000].
# YIELD_CRON_MAX_SUPPLY_CAP=10000000

# Hard ceiling on oracle snapshot staleness. Beyond this many days
# the cron skips the token + fires a WARN-level Telegram alert
# (operator notices via the bot). Default 7d is conservative for a
# nav-worker that's expected to publish hourly; tighten once
# nav-worker reliability is established.
# STALE_NAV_HALT_DAYS=7

# ── Wave 5 Path D Slice 1 Commit 3.5 — fhe-worker shared secret ─────────
# Backend forwards this value as the `X-FHE-Worker-Secret` header on
# every call into the fhe-worker's new `POST /api/v1/encrypt/for-account`
# endpoint (the autonomous-buy mediation path). The worker checks the
# header against its own `FHE_WORKER_SHARED_SECRET` and 401s on mismatch.
#
# When unset on EITHER side (backend or fhe-worker), the gate is open
# for back-compat with ops who haven't rotated env yet. Production
# hardening = set the SAME value on both sides. Legacy
# `/api/v1/encrypt/batch` is intentionally NOT gated (Wave 3 escrow
# flow predates this; rotating it is separate scope).
#
# Generate as 32 random bytes hex (≥32 chars recommended):
#   openssl rand -hex 32
#
# Must match `FHE_WORKER_SHARED_SECRET` in fhe-worker/.env exactly.
FHE_WORKER_SHARED_SECRET=

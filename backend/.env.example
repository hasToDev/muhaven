# backend/.env — template for the production backend service.
#
# Usage:
#   cp backend/.env.example backend/.env
#   # edit backend/.env, filling every <<FILL_*>> placeholder
#   scp backend/.env muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven/backend/.env
#
# The real .env is gitignored (see root .gitignore). Same key set as
# .env.stage.example — keep them in lockstep when adding a new key.
#
# Contract addresses pre-filled from deployments/arb-sepolia-v2.json
# (prod platform deploy 2026-05-04). Per-token JSON arrays stay empty
# until tokens are onboarded — fill them after running
# `MUHAVEN_TOKEN_SYMBOL=… pnpm run onboard-token:testnet`.

# ── Database ────────────────────────────────────────────────────────────────
# Password must match whatever DB_PASSWORD is set to on the homelab when
# bringing the stack up.
DB_PROVIDER=postgres
DATABASE_URL=postgresql://muhaven:<<FILL_PROD_DB_PASSWORD>>@postgres:5432/muhaven

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a fresh secret — do NOT reuse staging's. Command:
#   openssl rand -hex 32
JWT_SECRET=<<FILL_PROD_JWT_SECRET_64_HEX_CHARS>>
JWT_ISSUER=muhaven.xyz
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# ── Chain ───────────────────────────────────────────────────────────────────
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── CORS ────────────────────────────────────────────────────────────────────
# Production origin only. MUST NOT include muhaven-staging.hasto.dev.
ALLOWED_ORIGINS=http://localhost:7778,https://muhaven.hasto.dev

# ── FHE Worker (internal compose DNS) ───────────────────────────────────────
FHE_WORKER_URL=http://fhe-worker:3001

# ── Wave 3 contract addresses (read-only legacy view + KYC admin) ──────────
# Source: deployments/arb-sepolia.json. KYC_ADAPTER_ADDRESS stays active
# because demo-mode self-serve whitelist still writes to the Wave 3 adapter
# for parity with the Wave 3 backend.
MUHAVEN_TOKEN_ADDRESS=0xF95c9aA19e974e4cA0778AAdb76580423eEEeb03
MUHAVEN_VAULT_ADDRESS=0xF445898f1af1DFde88E26c75C4d35c9025C5C631
INVESTOR_REGISTRY_ADDRESS=0xE7D4CB42EdB19e268e5e8a10d1A02f321Bfa50D0
YIELD_DISTRIBUTOR_ADDRESS=0xD403252436e41EFd81D76eB9223485cB66cb1638
KYC_ADAPTER_ADDRESS=0x0aF7003E645b3f8028dac59556aa0Cf0AeA21851
RISK_PARAMS_ADDRESS=0x7F287982232De3C78c1958Aa11f3D9826B445604
YIELD_GATE_ADDRESS=0x2cBAa54E5Ce4ED6D68722e35E18eba77B1c11964

# ── Wave 3.5 contract addresses (active hot path) ──────────────────────────
# Source: deployments/arb-sepolia-v2.json. INVESTOR_REGISTRY_ADDRESS above
# already swapped to the Wave 3.5 fresh-deploy registry per MIGRATION.md.
SUBSCRIPTION_ADDRESS=0x39D49B2614d24ba189B613bEAa903d829A73eA9e
STABLE_ADDRESS=0xF9bc25b67238C870255c33EC75fA37A09C00edE7
# Read by seed-tokens-v35 to discover registered tokens AND by the
# tax-event indexer (Phase 9.A · Expansion F1) to subscribe to
# `TokenRegistry.IssuerUpdated` events.
TOKEN_REGISTRY_ADDRESS=0x4915E9Aa034244e299fb1609792D66b9fFAbf885

# Active oracle for the issuer NAV endpoints + NAV writer cron.
# IssuerControlledOracle is the default for Wave 3.5 (immediate seed, no
# DON dependency). Swap to ChainlinkFunctionsOracle (deployed at
# 0x6a480c6F7553098f7B9b0b285EcB7207a93feC43) by updating both this slot
# AND TokenRegistry.setOracle on-chain in lockstep.
ORACLE_ADDRESS=0xD30069114dFC83C714B04d6036dEfa64d2E9d583

# Tax-event indexer scope (per ADR-020 / ADR-040). JSON arrays of per-token
# Wave 3.5 contract addresses; empty array disables that path. Source:
# arb-sepolia-v2.json under tokens.{symbol}.contracts. TBILL1 + GOLD1
# pre-filled below; add new tokens after running
# `bash scripts/onboard-token.sh <symbol>`.
REDEMPTION_QUEUE_ADDRESSES_JSON=["0x435aF5AF238aBe80DD4dc571C38C167F407c4E9c","0x6f2D952c0350BB0d5F856df5F7f534dEAD6634A7"]
# Wave 3.5 deploys ONE shared YieldSnapshot proxy across every token
# (vs the per-token Subscription / Queue / Treasury), so this array has
# a single entry even with multiple tokens onboarded.
YIELD_SNAPSHOT_ADDRESSES_JSON=["0xaC4163f84db2C85333D5aF6f87848d7362A59887"]
# Phase 9.A · Option Z follow-up — per-RWA MuHavenToken proxies. The
# indexer subscribes to broadened Transfer(from, to, amount) logs and
# inserts two tax_events rows per qualifying P2P transfer (sender +
# recipient). Source: tokens.{symbol}.contracts.MuHavenToken.proxy.
MUHAVEN_TOKEN_ADDRESSES_JSON=["0x8D77cCf0a3a56c976a7DEAe59aF1D27f27407b0D","0x93e813e924A96441181A01171Cd1E20FaaC87AcF"]
# Phase 9.A · Option Z follow-up — protocol filter: addresses whose
# Transfer participation should NOT surface as a P2P /activity row.
# Subscription + queues + snapshots above are auto-included by the
# indexer; this list adds the per-RWA Treasury proxies.
TREASURY_ADDRESSES_JSON=["0xf423CE2d1fD856F89Ca75ec47c2791CeD91D62a3","0x5057b445d7Ac1AFbd834122f63A9652DfCb78157"]

# Tax-event indexer cron — Phase 9.A · Option Z makes this the canonical
# source for the activity feed (Wave 3 yield + escrow paths retired).
TAX_EVENT_POLLER_ENABLED=true
TAX_EVENT_POLLER_INTERVAL_MS=15000

# NAV writer cron — calls oracle.requestNAV(token) once per
# NAV_CRON_INTERVAL_MS for every active token in `rwa_tokens`. Off by
# default — only useful when the active oracle is ChainlinkFunctionsOracle
# (requestNAV does not exist on the issuer-write IssuerControlledOracle).
# Re-enable after swapping ORACLE_ADDRESS to ChainlinkFunctionsOracle.
#
# IMPORTANT: NAV_CRON_PRIVATE_KEY MUST be either empty (cron stays idle)
# or a 0x-prefixed 32-byte hex string. A placeholder like "<<FILL_*>>" or
# any non-hex string crashes the backend on boot inside viem's
# privateKeyToAccount.
NAV_CRON_ENABLED=false
NAV_CRON_INTERVAL_MS=3600000
NAV_CRON_PRIVATE_KEY=

# ── ReineiraOS infrastructure (shared with staging — unchanged) ────────────
# REINEIRA_ESCROW_ADDRESS is a legacy env var name — points at the prod
# MuHavenEscrow proxy (Phase 19B replaced ReineiraOS ConfidentialEscrow).
PUSDC_ADDRESS=0x6b6e6479b8b3237933c3ab9d8be969862d4ed89f
REINEIRA_ESCROW_ADDRESS=0xb18ca2122b31Df9Aaef8226f6218Bd93B852F40A
SIMPLE_CONDITION_ADDRESS=0x9817DA50DB5CE4316D2f0fF6bb6DBfe252C29593
CIRCLE_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
REINEIRA_COORDINATOR_URL=https://dswtxw6k9mker.cloudfront.net

# ── Block event poller (Phase 19D) ──────────────────────────────────────────
# Phase 9.A · Option C / Option Z — Wave 3 yield + escrow paths retired.
# `/activity` reads from `tax_events` only; the legacy poller is a no-op
# on a Wave-3.5-only stack.
BLOCK_POLLER_ENABLED=false
BLOCK_POLLER_INTERVAL_MS=15000

# ── Demo-mode self-serve whitelist ──────────────────────────────────────────
# ERC3643KYCAdapter has a single admin slot set at deploy time = deployer.
# Leave blank to disable the endpoint entirely (returns 503).
DEMO_WHITELIST_PRIVATE_KEY=<<FILL_PROD_DEPLOYER_PRIVATE_KEY>>

# ── Webhooks (optional) ─────────────────────────────────────────────────────
QUICKNODE_WEBHOOK_SECRET=

# ── Phase 9.A · Expansion (F2) — self-serve issuer onboarding ──────────────
# Toggle + addresses + key for the `/v1/issuer/tokens/deploy` endpoint.
# When ISSUER_ONBOARDING_ENABLED=false (default) OR when any of the
# addresses + key below are missing, the deploy endpoint returns 503.
#
# PLATFORM_DEPLOYER_PRIVATE_KEY is the SAME EOA as the project root's
# PRIVATE_KEY (the platform deployer that owns TokenRegistry +
# InvestorRegistry + ModularCompliance + IssuerControlledOracle — every
# `onlyOwner`-gated call the deploy library makes). Using a fresh key
# requires `transferOwnership` on all four contracts first. Needs Arb
# Sepolia ETH (~0.005 ETH per deploy). Zero PUSDC float.
ISSUER_ONBOARDING_ENABLED=true
PLATFORM_DEPLOYER_PRIVATE_KEY=<<FILL_SAME_AS_ROOT_DOTENV_PRIVATE_KEY>>
# Source: deployments/arb-sepolia-v2.json
INVESTOR_REGISTRY_V35_ADDRESS=0xE7D4CB42EdB19e268e5e8a10d1A02f321Bfa50D0
YIELD_SNAPSHOT_ADDRESS=0xaC4163f84db2C85333D5aF6f87848d7362A59887
IDENTITY_REGISTRY_ADDRESS=0xD9Ab61fdED044bcBeB9eF687C357A35B5E7E9fAD
MODULAR_COMPLIANCE_ADDRESS=0x9A190A310C23FcF9Cd6c5Eab26Eb624B89e4D07a
ISSUER_ORACLE_ADDRESS=0xD30069114dFC83C714B04d6036dEfa64d2E9d583
# Path inside the backend container where compiled contract artifacts
# (MuHavenToken / RedemptionQueue / MuHavenTreasury bytecode + ABI) are
# baked in. `scripts/deploy-homelab.sh` stages `artifacts/contracts/`
# into `backend/contracts-artifacts/contracts/` before docker build.
MUHAVEN_ARTIFACTS_DIR=/app/contracts-artifacts

# ── Wave 4 P2 — HavenBot LLM (Google Gemini) ──────────────────────────────
# When set, ChatLlmService routes the /api/v1/agent/chat/stream path through
# Google Gemini 2.0 Flash with function-calling for tool dispatch. When
# unset, the deterministic stub classifier fires instead. Production should
# set this to a paid Google Cloud Gemini key once the chat surface is
# promoted to GA in Wave 5.
GEMINI_API_KEY=
# Optional model override — defaults to `gemini-2.5-flash` (current
# Flash tier; `gemini-2.0-flash` was retired for new keys 2026-05-09).
# GEMINI_MODEL=gemini-2.5-flash

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=3000

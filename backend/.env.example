# Database
DB_PROVIDER=postgres
DATABASE_URL=postgresql://muhaven:muhaven@localhost:5432/muhaven

# Auth
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
JWT_ISSUER=muhaven.xyz
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Chain
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# CORS
ALLOWED_ORIGINS=http://localhost:7778,https://muhaven.hasto.dev

# FHE Worker
FHE_WORKER_URL=http://localhost:3001

# MuHaven Contract Addresses (Arb Sepolia — populate from deployments/arb-sepolia.json)
# INVESTOR_REGISTRY_ADDRESS is required when BLOCK_POLLER_ENABLED=true (Phase 19D poller
# reads the registry to reconstruct escrowId → investor mapping from EscrowIdsAttached).
MUHAVEN_TOKEN_ADDRESS=
MUHAVEN_VAULT_ADDRESS=
INVESTOR_REGISTRY_ADDRESS=
YIELD_DISTRIBUTOR_ADDRESS=
KYC_ADAPTER_ADDRESS=
RISK_PARAMS_ADDRESS=
YIELD_GATE_ADDRESS=

# MuHaven + ReineiraOS infrastructure (Arb Sepolia — live testnet addresses)
# REINEIRA_ESCROW_ADDRESS is retained as the env var name for back-compat but now
# points at MuHavenEscrow (Phase 19B replaced ReineiraOS ConfidentialEscrow).
PUSDC_ADDRESS=0x6b6e6479b8b3237933c3ab9d8be969862d4ed89f
REINEIRA_ESCROW_ADDRESS=
SIMPLE_CONDITION_ADDRESS=0x9817DA50DB5CE4316D2f0fF6bb6DBfe252C29593
CIRCLE_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
REINEIRA_COORDINATOR_URL=https://dswtxw6k9mker.cloudfront.net

# Block event poller (Phase 19D). Enable to have the backend ingest
# EscrowIdsAttached + EscrowRedeemed from Arb Sepolia on a 15s cadence.
# Requires REINEIRA_ESCROW_ADDRESS, YIELD_DISTRIBUTOR_ADDRESS, INVESTOR_REGISTRY_ADDRESS, RPC_URL.
BLOCK_POLLER_ENABLED=false
BLOCK_POLLER_INTERVAL_MS=15000

# Demo-mode self-serve whitelist (POST /api/v1/demo/whitelist-self).
# Private key (0x-prefixed) of the current ERC3643KYCAdapter admin. The adapter
# has a single admin slot, so this is the deployer key until the adapter is
# upgraded to multi-admin. Leave blank to disable the endpoint (returns 503).
DEMO_WHITELIST_PRIVATE_KEY=

# Webhooks (optional)
QUICKNODE_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info
PORT=3000

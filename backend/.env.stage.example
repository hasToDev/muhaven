# backend/.env.stage — template for the staging backend service.
#
# Usage:
#   cp backend/.env.stage.example backend/.env.stage
#   # edit backend/.env.stage, filling every <<FILL_*>> placeholder
#   scp backend/.env.stage muhaven@192.168.1.52:/home/muhaven/Project/Fhenix/MuHaven-stage/backend/.env.stage
#
# The filled .env.stage is gitignored (see root .gitignore).
# Contract addresses below come from deployments/arb-sepolia.staging.json.

# ── Database ────────────────────────────────────────────────────────────────
# Password must match whatever DB_PASSWORD is set to on the homelab when
# bringing the stack up. Simplest: leave both at "muhaven" for staging.
DB_PROVIDER=postgres
DATABASE_URL=postgresql://muhaven:<<FILL_STAGING_DB_PASSWORD>>@postgres:5432/muhaven

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a fresh secret — do NOT reuse prod's. Command:
#   openssl rand -hex 32
JWT_SECRET=<<FILL_STAGING_JWT_SECRET_64_HEX_CHARS>>
JWT_ISSUER=muhaven.xyz
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# ── Chain ───────────────────────────────────────────────────────────────────
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── CORS ────────────────────────────────────────────────────────────────────
# MUST NOT include muhaven.app or pay.muhaven.app — prevents the staging
# backend from accepting requests belonging on prod.
#
# `pay-stage.muhaven.app` is the hosted-checkout buyer page (P5 §5). It
# is a separate Cloudflare-Pages route from the dashboard SPA so the
# buyer-page CSP can be tighter; it MUST appear in ALLOWED_ORIGINS or
# the buyer page's POST `/checkout/sessions/lookup` + GET
# `/checkout/sessions/events` will be CORS-blocked.
ALLOWED_ORIGINS=http://localhost:7778,http://localhost:7780,https://stage.muhaven.app,https://pay-stage.muhaven.app

# ── FHE Worker (internal compose DNS) ───────────────────────────────────────
# Port 3001 is the CONTAINER-internal port — same as prod. Compose's own
# network isolates the two stacks, so no conflict. The host-side offset
# (4001 on the homelab) lives in docker-compose.stage.yml, not here.
FHE_WORKER_URL=http://fhe-worker:3001

# ── Wave 3 contract addresses (read-only legacy view + KYC admin) ──────────
# Source: deployments/arb-sepolia.staging.json. KYC_ADAPTER_ADDRESS stays
# active because demo-mode self-serve whitelist still writes to the Wave 3
# adapter for parity with the Wave 3 backend.
MUHAVEN_TOKEN_ADDRESS=0x886534eCf78922185e8DE6e70D2EfC55Ee4dBEA9
MUHAVEN_VAULT_ADDRESS=0x04870D3806C589c065F8e37557fAB5D689B872AD
# INVESTOR_REGISTRY_ADDRESS rotates with each Wave 3.5 platform redeploy
# (see arb-sepolia-v2.staging.json `contracts.InvestorRegistry.proxy`).
# Mirrored into INVESTOR_REGISTRY_V35_ADDRESS below for the F2 wizard.
INVESTOR_REGISTRY_ADDRESS=0x16624D01086Eb2A23492cd261d85E238ebc07468
YIELD_DISTRIBUTOR_ADDRESS=0x5BcbCC52F5ca445bC13c311FC544fdBA77db944f
KYC_ADAPTER_ADDRESS=0x02Fd3E06c6b1FD849ec94F456a67d1852f2b2a56
RISK_PARAMS_ADDRESS=0xD2586C6891e965158072C36fAeB0b00d212f67B8
YIELD_GATE_ADDRESS=0x9165104828f252Fc7F9277F21D59E78BA0827505

# ── Wave 3.5 contract addresses (active hot path) ──────────────────────────
# Source: deployments/arb-sepolia-v2.staging.json (fresh staging deploy
# 2026-05-08). INVESTOR_REGISTRY_ADDRESS above already swapped to the
# Wave 3.5 fresh-deploy registry per MIGRATION.md "Wave 3.5 deploys a
# fresh InvestorRegistry".
#
# IMPORTANT: when the staging platform is redeployed (`pnpm run
# deploy:v2:testnet:stage` + `bash scripts/onboard-token.sh <symbol>
# stage`), every JSON array below MUST be rotated in lockstep — stale
# entries leave the tax-event indexer subscribed to dead contracts. The
# user-visible symptom is: tx confirmed on-chain but row never appears
# on /activity. Cross-check against `tokens.{symbol}.contracts.*.proxy`
# in `deployments/arb-sepolia-v2.staging.json`.
SUBSCRIPTION_ADDRESS=0x6238d7f702F192dE4B84f7d9A38A4F569fc04466
STABLE_ADDRESS=0x08Cc77db8243c22153dDEc28A5505Fb41Ca0AfF5
# Read by seed-tokens-v35 to discover which tokens to insert into rwa_tokens
# AND by the tax-event indexer (Phase 9.A · Expansion F1) to subscribe to
# `TokenRegistry.IssuerUpdated` events — rotations applied via
# `scripts/transfer-issuer.ts` now propagate to `rwa_tokens.issuer_address`
# automatically without an operator running `pnpm seed:sync-issuers`.
# Leave unset to disable the registry leg of the indexer feed (legacy fall-
# back: `pnpm seed:sync-issuers` is still safe to re-run idempotently).
TOKEN_REGISTRY_ADDRESS=0x95030e3c3302B8FC0c2e5cEb425a57FA889f9AC6

# Active oracle for the issuer NAV endpoints + NAV writer cron. Today the
# IssuerControlledOracle is registered in TokenRegistry for both TBILL1 +
# GOLD1 (immediate seed, no DON dependency). The ChainlinkFunctionsOracle
# is deployed at 0x803B563C5E1082750479c373BD83DdA07EE18319 and per-token
# configured — swap ORACLE_ADDRESS here AND TokenRegistry.setOracle on-chain
# in lockstep when migrating to the DON-driven path.
ORACLE_ADDRESS=0x1e799f7bA4B1e4D5c835C5af6491c188944C0594

# Tax-event indexer scope (per ADR-020 / ADR-040). JSON arrays of per-token
# Wave 3.5 contract addresses; empty array disables that path. Source:
# arb-sepolia-v2.staging.json under tokens.{symbol}.contracts.
REDEMPTION_QUEUE_ADDRESSES_JSON=["0x994989781f221b59985DD7b30eE10906b95fa2Be","0xB2e6Aa27C7C31ab18D33d0CbB20a30A7138670B4"]
YIELD_SNAPSHOT_ADDRESSES_JSON=["0x4942d1dE584CE7e6f3407d6E86efFbB9ED81fd1C"]
# Phase 9.A · Option Z follow-up — per-RWA MuHavenToken proxies. The
# indexer subscribes to broadened Transfer(from, to, amount) logs and
# inserts two tax_events rows per qualifying P2P transfer (sender +
# recipient). Source: tokens.{symbol}.contracts.MuHavenToken.proxy.
# Stale entries here are the most common cause of "transfer tx confirmed
# but /activity row never appears" — cross-check the deployment file
# AFTER every staging redeploy.
MUHAVEN_TOKEN_ADDRESSES_JSON=["0xe80a64C13759e9b823265e2691c7C481EaAaf6e2","0x80327c5D46c2c4C517B5f021f69cA7667f30b270"]
# Phase 9.A · Option Z follow-up — protocol filter: addresses whose
# Transfer participation should NOT surface as a P2P /activity row.
# Subscription + queues + snapshots above are auto-included by the
# indexer; this list adds the per-RWA Treasury proxies (and any other
# protocol-internal contract that participates in Transfer events).
TREASURY_ADDRESSES_JSON=["0x46a304002A7c02e387726af06d9C640B39D75064","0x756AdFe36F29886be0dfF87F80D4FC9D6ddDF414"]

# Tax-event indexer cron — Phase 9.A · Option Z makes this the canonical
# source for the activity feed (Wave 3 yield + escrow paths retired). Keep
# this `true` on staging post-Option-Z.
TAX_EVENT_POLLER_ENABLED=true
TAX_EVENT_POLLER_INTERVAL_MS=15000

# NAV writer cron — calls oracle.requestNAV(token) once per
# NAV_CRON_INTERVAL_MS for every active token in `rwa_tokens`. Off by default
# in staging until the Chainlink path is the active oracle (it does nothing
# useful when the active oracle is the issuer-write IssuerControlledOracle —
# requestNAV does not exist on that surface). Re-enable after swapping
# ORACLE_ADDRESS to the ChainlinkFunctionsOracle.
#
# IMPORTANT: NAV_CRON_PRIVATE_KEY MUST be either empty (cron stays idle)
# or a 0x-prefixed 32-byte hex string. A placeholder like "<<FILL_*>>" or
# any non-hex string crashes the backend on boot inside viem's
# privateKeyToAccount. The dev-server gate now hex-shapes the value AND
# falls through to "skipping" if the shape doesn't match (defensive), but
# leaving this empty is still the cleanest "not configured" signal.
NAV_CRON_ENABLED=false
NAV_CRON_INTERVAL_MS=3600000
NAV_CRON_PRIVATE_KEY=

# ── ReineiraOS infrastructure (shared with prod — unchanged) ────────────────
# REINEIRA_ESCROW_ADDRESS is a legacy env var name — points at the staging
# MuHavenEscrow proxy (Phase 19B replaced ReineiraOS ConfidentialEscrow).
PUSDC_ADDRESS=0x6b6e6479b8b3237933c3ab9d8be969862d4ed89f
REINEIRA_ESCROW_ADDRESS=0xafBfcF26f9951F793647B2628013B2cA0bA6F94D
SIMPLE_CONDITION_ADDRESS=0x9817DA50DB5CE4316D2f0fF6bb6DBfe252C29593
CIRCLE_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
REINEIRA_COORDINATOR_URL=https://dswtxw6k9mker.cloudfront.net

# ── Block event poller (Phase 19D) ──────────────────────────────────────────
# Phase 9.A · Option C / Option Z — Wave 3 yield + escrow paths retired.
# `/activity` reads from `tax_events` only; the legacy poller is a no-op
# on a Wave-3.5-only stack. Existing yield/escrow rows remain in DB.
BLOCK_POLLER_ENABLED=false
BLOCK_POLLER_INTERVAL_MS=15000

# ── Demo-mode self-serve whitelist ──────────────────────────────────────────
# ERC3643KYCAdapter has a single admin slot set at deploy time = deployer.
# For staging that's your STAGING_PRIVATE_KEY (the key that ran
# `pnpm run deploy:testnet:stage`).
DEMO_WHITELIST_PRIVATE_KEY=<<FILL_STAGING_PRIVATE_KEY>>

# ── Webhooks (optional) ─────────────────────────────────────────────────────
QUICKNODE_WEBHOOK_SECRET=

# ── Phase 9.A · Expansion (F2) — self-serve issuer onboarding ──────────────
# Toggle + addresses + key for the `/v1/issuer/tokens/deploy` endpoint.
# When ISSUER_ONBOARDING_ENABLED=false (default) OR when any of the
# addresses + key below are missing, the deploy endpoint returns 503 and
# the wizard's step 5 surfaces a service-unavailable error. The
# /v1/issuer/apply endpoint works without these (only requires the
# schema migration + backfill via `pnpm tsx scripts/backfill-issuer-status.ts`).
#
# Deploy key custody: same EOA as the project root's PRIVATE_KEY (the
# platform deployer that ran `pnpm run deploy:v2:testnet:stage`). The
# deploy library calls four `onlyOwner`-gated platform functions —
# TokenRegistry.registerToken, InvestorRegistry.setAuthorizedCaller,
# ModularCompliance.setAuthorizedCaller, IssuerControlledOracle.setNavWriter
# / setMaxDeviationBps — all owned by the original deployer EOA. Using
# a fresh key would require running `transferOwnership` on each contract
# (operational risk, post-hackathon work). For now: copy the value from
# the root .env's PRIVATE_KEY into this slot. Same key, two homes.
# Custody trade-off accepted (same posture as FHE_WORKER_PRIVATE_KEY +
# NAV_CRON_PRIVATE_KEY). chmod 600 on host.
#
# Balance: needs Arb Sepolia ETH for gas (~0.005 ETH per deploy across
# ~19 txs). Recommended floor: 0.05 ETH = ~10 deploys before refilling.
# Faucets: https://faucet.quicknode.com/arbitrum/sepolia or
# https://www.alchemy.com/faucets/arbitrum-sepolia (~0.1-0.25 ETH per
# request). Zero PUSDC float — issuer kernel funds treasury post-deploy.
ISSUER_ONBOARDING_ENABLED=true
PLATFORM_DEPLOYER_PRIVATE_KEY=<<FILL_SAME_AS_ROOT_DOTENV_PRIVATE_KEY>>
# Source: deployments/arb-sepolia-v2.staging.json (refreshed 2026-05-08
# for the agenticwave fresh staging deploy).
INVESTOR_REGISTRY_V35_ADDRESS=0x16624D01086Eb2A23492cd261d85E238ebc07468
YIELD_SNAPSHOT_ADDRESS=0x4942d1dE584CE7e6f3407d6E86efFbB9ED81fd1C
IDENTITY_REGISTRY_ADDRESS=0x265c5B13690e785A6607A13fF59e05533e3338Eb
MODULAR_COMPLIANCE_ADDRESS=0x83912E1fF0A2cc3680B696f9beC53cD28E3E7e20
ISSUER_ORACLE_ADDRESS=0x1e799f7bA4B1e4D5c835C5af6491c188944C0594
# 2026-05-17 Design A · PREVENTION — platform-managed NAV writer EOA.
# MUST equal the address derived from PLATFORM_DEPLOYER_PRIVATE_KEY (the
# server-side setNAV signer used by the wizard step-6 unpause flow).
# Same EOA as the prod deployer in staging today (`0xe11E...6986`).
PLATFORM_NAV_WRITER_ADDRESS=<<FILL_WITH_ADDRESS_DERIVED_FROM_PLATFORM_DEPLOYER_PRIVATE_KEY>>

# ── Wave 4 P11 — DefaultProtection / EncryptedGovernance / KYC stub ──
# First-time on-chain deploy on staging 2026-05-08 (per
# `scripts/deploy-p11.ts`). Source: deployments/arb-sepolia-v2.staging.json
# under `p11.contracts.*`. Backend doesn't currently consume these directly,
# but the staging frontend's HavenBot tool catalog + `@muhaven/mcp` issuer
# namespace need them in the env for cross-surface tool discovery + the
# operator-runbook AGENTIC_TEST_PLAN.md flows. Keep in sync with prod when
# P11 lands there.
DEFAULT_PROTECTION_ADDRESS=0x52Dc40995dF5ab5bd2463F49516946fEa4a2122a
ENCRYPTED_GOVERNANCE_ADDRESS=0x59298178aF7635d20164B23632Fc1656dc9Fdf32
KYC_ATTESTATION_REGISTRY_ADDRESS=0x948036BC34056B849f60E2329ca97d933FC55e75
MUHAVEN_KYC_VERIFIER_ADDRESS=0xC1B500b52F14817e341aC269de0e2c147119A9Bf
# Path inside the backend container where compiled contract artifacts
# (MuHavenToken / RedemptionQueue / MuHavenTreasury bytecode + ABI) are
# baked in. `scripts/deploy-homelab.sh` stages `artifacts/contracts/`
# into `backend/contracts-artifacts/contracts/` before docker build.
MUHAVEN_ARTIFACTS_DIR=/app/contracts-artifacts

# ── Wave 4 P2 — HavenBot LLM (Google Gemini) ──────────────────────────────
# When set, ChatLlmService routes the /api/v1/agent/chat/stream path through
# Google Gemini 2.0 Flash with function-calling for tool dispatch. When
# unset, the deterministic stub classifier in `chat-llm.service.ts` fires
# instead — same SSE wire shape, but only recognises "portfolio" / "pause"
# from natural language. Steps 4-7 of `AGENTIC_TEST_PLAN.md §1c` (quote /
# buy / protection coverage) require Gemini to drive tool selection.
#
# Get a free key at https://aistudio.google.com/apikey (rate-limited but
# ample for dev + staging). Production should rotate to a paid key when
# AGENT_DESIGN.md Wave 5 promotes the chat surface to GA.
GEMINI_API_KEY=<<FILL_GOOGLE_AI_STUDIO_API_KEY>>
# Optional override — defaults to `gemini-2.5-flash` (current Flash tier
# as of 2026-05-09; `gemini-2.0-flash` was retired for new keys with a
# 404 NOT_FOUND from generativelanguage.googleapis.com). Smaller /
# cheaper than `pro`, fast enough for the ~6-min onboarding budget.
# GEMINI_MODEL=gemini-2.5-flash

# ── Wave 4 P4 / P7 — OpenClaw / Telegram surface ────────────────────────────
# Backend reads four user-set + one internal-DNS Telegram env vars. ALL
# are optional at the schema level (zod `.optional()` in
# `backend/src/core/config.ts`); leaving the block empty disables the
# Telegram integration end-to-end (worker-shaped routes 503, Mini App
# initData verifier never builds, deep-link renderer falls back to a
# generic "configure your bot" string).
#
# These MUST mirror the values in `telegram-bot/.env.stage` — the worker
# and the backend share the bot token (Mini App initData HMAC) and the
# service secret (worker→backend authentication). Use a SEPARATE bot
# from prod (BotFather → /newbot → e.g. muhaven_stage_bot); a shared bot
# would cross-route confirmation flows.
#
# Required for `AGENTIC_TEST_PLAN.md §4` walkthrough — leaving the block
# empty makes the §4c manual-smoke steps fail at the link-Telegram step.

# Service-to-service secret presented by the `telegram-bot/` worker on
# every call into the backend's `/api/v1/agent/openclaw/*` worker-shaped
# routes. Same value the staging worker reads from
# TELEGRAM_BOT_SERVICE_SECRET in `telegram-bot/.env.stage`. Generate
# fresh — do NOT reuse prod's:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_BOT_SERVICE_SECRET=<<FILL_STAGING_SERVICE_SECRET_64_HEX_CHARS>>

# Bot token from @BotFather (staging bot). Used by the backend ONLY to
# verify Mini App initData HMACs. MUST be byte-identical to the staging
# worker's TELEGRAM_BOT_TOKEN; a divergence means valid Mini App requests
# fail initData verification.
TELEGRAM_BOT_TOKEN=<<FILL_STAGING_BOTFATHER_TOKEN>>

# Bot username without leading `@` (staging bot, e.g. muhaven_stage_bot).
# Used by the backend's deeplink renderer to build
# `t.me/<username>?start=<linkCode>` strings surfaced to the staging
# dashboard `/agent` Telegram-link tab.
TELEGRAM_BOT_USERNAME=<<FILL_STAGING_BOT_USERNAME>>

# Public Mini App URL (the `web_app` button on the mid-tier inline
# keyboard, $200–$5K). Staging Mini App lives on the staging dashboard
# origin so the WebAuthn RP-ID resolves correctly for the >$5K passkey
# deep-link tier. Mirror the worker's TELEGRAM_MINI_APP_URL.
TELEGRAM_MINI_APP_URL=https://stage.muhaven.app/telegram-mini-app

# Wave 4 P7 — base URL of the running `telegram-bot/` worker so the
# backend can publish issuer-narrative broadcasts. Container name
# `telegram-bot` resolves inside the muhaven-stage docker network; the
# in-container port 3004 matches the worker's PORT (the +1000 host-port
# offset — 4004 — is for external Cloudflare-tunnel traffic only and
# is NOT used here). When unset OR when the operator has deferred
# channel setup (TELEGRAM_ISSUER_CHANNEL_ID empty on the worker side),
# the use-case falls back to LoggingIssuerChannelTransport (events log
# + drop). Wave 4 P4 surface ALSO reads this — the backend → bot
# `/intent/notify` push channel uses the same env var. Uncomment to
# wire both paths.
TELEGRAM_BOT_WORKER_URL=http://telegram-bot:3004

# ── Wave 4 P4 — STAGING-ONLY tier-threshold overrides ──────────────
# Lower the OpenClaw three-tier classifier ceilings so the §4
# walkthrough's tiny test amounts (e.g. 2 mhUSDC) route to a non-inline
# tier. Default ceilings (production):
#   inline       ≤ $200      (ceiling = 200_000_000 USDC 6dp units)
#   mini_app_otp ≤ $5,000    (ceiling = 5_000_000_000 USDC 6dp units)
#   passkey_deeplink > $5,000
# `classifyTier` REJECTS overrides ABOVE the regulatory caps — only
# LOWERING is supported (Reg BI Care Obligation + FINRA IM-2017-02).
# Production deploys MUST leave both UNSET; the staging defaults below
# put 2 mhUSDC ($2 = 2_000_000 6dp units) into mid-tier so the Mini App
# + OTP surface can be exercised end-to-end with tiny test balances.
OPENCLAW_TIER_INLINE_MAX_USD6=0
# Mini-app ceiling unchanged at the production cap; the inline-floor
# drop is enough to route 2 mhUSDC to mid-tier without raising the
# upper bound.
# OPENCLAW_TIER_MINI_APP_MAX_USD6=5000000000

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# In-container port. Host-side port (4000) is set in docker-compose.stage.yml.
PORT=3000

# ── Wave 4 P5 — Hosted checkout (`stage.muhaven.app/pay/`) ──────────────
# Public base URL of the hosted-checkout buyer page. The backend's
# `POST /api/v1/checkout/sessions/create` use-case writes
# `<CHECKOUT_PUBLIC_URL>/c/<sessionId>#k=<fragmentKey>` into the
# response payload it returns to the issuer.
#
# 2026-05-15 subdomain-collapse: was `https://pay-stage.muhaven.app`; now
# points at the dashboard apex with a `/pay` path prefix. Same-origin
# is the architectural pivot that lets Chrome on Windows offer GPM
# at the UserOp signing step instead of routing to the OS-native
# Windows Hello dialog. Operator hosting model: dist for
# `apps/checkout-pay/` is built into `muhaven-web-stage/pay/` (a
# subdirectory of the dashboard's stage sibling repo). The legacy
# `muhaven-checkout-web-stage` repo is repurposed as a JS-redirect
# shim so pre-migration URLs at `pay-stage.muhaven.app/c/<id>#k=…`
# still resolve.
CHECKOUT_PUBLIC_URL=https://stage.muhaven.app/pay

# ── Wave 5 Q3 step 3 — operator-alert surface (optional, stage) ─────────
# Stage parity for the prod operator-alert wiring. Same posture as prod:
# leave both blank to keep alerts log-only (LoggingOperatorAlertTransport);
# fill both to activate the HTTP → telegram-bot → Telegram chain. On
# stage, recommend a separate Telegram chat (not the prod chat) so dry-
# run noise doesn't pollute prod ops signal. See prod .env.example for
# the full schema rationale + generation commands.
# OPERATOR_TELEGRAM_CHAT_ID=12345
# OPERATOR_ALERT_TEST_SECRET=replace-with-32-random-bytes-hex

# ── Wave 5 Q3 step 4 — daily yield-distribution cron (optional, stage) ──
# Stage parity for the prod yield-cron wiring. Same OPT-IN posture as
# prod: keep YIELD_CRON_ENABLED=false until both operator-alert vars
# above are provisioned AND the issuer EOA holds pre-wrapped mhUSDC
# float on stage. See prod .env.example for the full rationale + the
# rollout sequence (dry-run smoke before flipping live).
#
# IMPORTANT: YIELD_CRON_PRIVATE_KEY must be UNSET or a 0x-prefixed
# 32-byte hex. Placeholders boot-fail the schema regex. Typically the
# stage PLATFORM_DEPLOYER_PRIVATE_KEY value (same EOA as the
# staging deployer; rotate pre-mainnet).

YIELD_CRON_ENABLED=false
YIELD_CRON_PRIVATE_KEY=
YIELD_CRON_DRY_RUN=true

# Tuning knobs (all optional, defaults safe; see prod .env.example for
# the regex restriction on YIELD_CRON_CRON_EXPR — sub-hourly rejected).
# YIELD_CRON_CRON_EXPR=0 0 * * *
# YIELD_CRON_MAX_SUPPLY_CAP=10000000
# FU-1 (Wave 5 W2) snapshot-based fund sizing — default true; fund
# min(decryptedSupply, MAX_SUPPLY_CAP) × rate. `=false` → legacy cap-based.
# YIELD_CRON_SNAPSHOT_FUNDING=true
# STALE_NAV_HALT_DAYS=7

# ── Wave 5 Path D Slice 1 Commit 3.5 — fhe-worker shared secret ─────────
# Stage parity for the prod wiring. Backend forwards this value as
# `X-FHE-Worker-Secret` to fhe-worker's `/api/v1/encrypt/for-account`;
# worker 401s on mismatch. When unset on either side the gate is open
# (back-compat). MUST match `FHE_WORKER_SHARED_SECRET` in
# fhe-worker/.env.stage. Generate fresh per environment — do NOT reuse
# the prod secret:
#   openssl rand -hex 32
FHE_WORKER_SHARED_SECRET=

{
  "name": "@muhaven/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "description": "MuHaven backend — adapted from ReineiraOS Platform Modules",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev-server.ts",
    "start": "tsx src/dev-server.ts",
    "build": "tsup && pnpm generate:openapi",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:tokens:v35": "tsx scripts/seed-tokens-v35.ts",
    "seed:sync-issuers": "tsx scripts/sync-token-issuers.ts",
    "seed:demo-issuers": "tsx scripts/seed-demo-issuers.ts",
    "ingest:oracle": "tsx scripts/ingest-oracle.ts",
    "seed:yield-overrides": "tsx scripts/seed-yield-bearing-overrides.ts"
  },
  "dependencies": {
    "@cofhe/sdk": "^0.5.1",
    "@google/genai": "^2.0.1",
    "@openzeppelin/contracts": "^5",
    "drizzle-orm": "^0.40",
    "ethers": "^6.4.0",
    "jose": "^6",
    "node-cron": "^3.0.3",
    "pg": "^8",
    "pino": "^9",
    "siwe": "^2",
    "tsx": "^4",
    "viem": "^2",
    "zod": "^3.24",
    "zod-openapi": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8",
    "@vercel/node": "^5.8.8",
    "drizzle-kit": "^0.30",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "license": "MIT"
}

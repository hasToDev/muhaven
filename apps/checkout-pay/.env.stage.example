# apps/checkout-pay/.env.stage — template. Vite reads this when invoked
# as `vite build --mode stage`. The VITE_-prefixed values below are
# statically replaced into the bundle at compile time and surface as
# `import.meta.env.VITE_<NAME>` in `src/*.ts`.
#
# Wave 4 P5 (initial) — the hosted-checkout buyer page is served from a
# separate subdomain (`pay-stage.muhaven.app`) so the kernel-passkey
# ceremony's RP-ID (`muhaven.app` apex) resolves correctly against the
# dashboard's apex. Without `VITE_BACKEND_URL`, the bundle's hostname
# heuristic in `backend.ts:DEFAULT_BASE` already routes
# `pay-stage.muhaven.app` requests to `https://api-stage.muhaven.app`
# — this file is the explicit build-time pin for off-host deploy
# targets (e.g. preview environments or a separate Cloudflare Pages
# route).
#
# Wave 4 P5 (Wave-5 buyer-side port, 2026-05-1?) — added ZeroDev +
# RPC + chain env vars so the buyer page can run a real passkey
# ceremony (P1), poll the buyer's USDC balance (P2), and execute
# wrap+approve+purchase UserOps via the buyer's kernel (P3). The
# bundler + passkey-server values reuse the dashboard's stage
# project — operator added `https://pay-stage.muhaven.app` to the
# project's Domains list, so kernels provisioned here are recoverable
# from `stage.muhaven.app` and vice versa.
#
# Copy the bundler / passkey-server values directly from
# `frontend/.env.stage` (same project) when populating the real
# `.env.stage`. Other addresses come from
# `deployments/arb-sepolia-v2.staging.json`.
VITE_BACKEND_URL=https://api-stage.muhaven.app

# ── ZeroDev passkey (Wave 5 buyer-side port, P1) ──
# Both values identical to `frontend/.env.stage`. Operator added
# `https://pay-stage.muhaven.app` to this project's Domains list so
# WebAuthn credentials work across both surfaces.
VITE_ZERODEV_BUNDLER_URL=
VITE_ZERODEV_PASSKEY_SERVER_URL=

# ── Chain (Wave 5 buyer-side port, P1) ──
VITE_CHAIN_ID=421614
VITE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Token addresses (Wave 5 buyer-side port, P2 + P3) ──
# Copy from `deployments/arb-sepolia-v2.staging.json`:
# - `external.usdc`     → VITE_USDC_ADDRESS
# - `proxies.muHavenStable` → VITE_MUHAVEN_STABLE_ADDRESS
# - `proxies.subscription`  → VITE_SUBSCRIPTION_ADDRESS
VITE_USDC_ADDRESS=
VITE_MUHAVEN_STABLE_ADDRESS=
VITE_SUBSCRIPTION_ADDRESS=
# Legacy PUSDC — pre-Wave-3.5 ConfidentialUSDC. Same value for prod +
# staging (immutable, shared). Default in chain.ts is correct; leave
# blank unless you've redeployed legacy PUSDC. The buyer page needs
# this for the USDC → PUSDC → mhUSDC wrap chain (P3).
VITE_LEGACY_PUSDC_ADDRESS=

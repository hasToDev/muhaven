{
  "name": "@muhaven/checkout-pay",
  "version": "0.1.1",
  "private": true,
  "description": "Hosted checkout buyer page for MuHaven (pay.muhaven.app). Renders the issuer label + decrypted amount, runs the ZeroDev passkey ceremony, and walks the buyer through fund → wrap → buy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/deploy-to-checkout-web.mjs",
    "build:stage": "vite build --mode stage && MUHAVEN_CHECKOUT_WEB_TARGET_DIR=../../../muhaven-checkout-web-stage node scripts/deploy-to-checkout-web.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22",
    "jsdom": "^25",
    "typescript": "^5.7",
    "vite": "^5.4.0",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

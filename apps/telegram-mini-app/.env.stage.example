# apps/telegram-mini-app/.env.stage — template (the real `.env.stage` is
# committed alongside since it carries no secrets — just a public URL).
#
# Vite reads this when invoked as `vite build --mode stage`. The
# VITE_-prefixed value below is statically replaced into the bundle at
# compile time and surfaces as `import.meta.env.VITE_MUHAVEN_BACKEND_URL`
# in `src/main.ts`.
#
# `bun run build:stage` from the frontend/ root chains this build into
# `frontend/dist/telegram-mini-app/` so the staging Mini App is served
# at `https://stage.muhaven.app/telegram-mini-app/`.
VITE_MUHAVEN_BACKEND_URL=https://api-stage.muhaven.app

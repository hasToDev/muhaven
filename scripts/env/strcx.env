# scripts/env/strcx.env
#
# Wave 5 Q1 — wrap Strategy PP Variable xStock (STRCx).
# NAV seeded from oracle_snapshots.nav_dollar × 1e6 at 2026-05-19 ingest;
# nav-publisher refresh cycle keeps it current after deploy.
#
# Source via: bash scripts/onboard-token.sh strcx [prod|stage]
#
# PREREQ: export MUHAVEN_NAV_WRITER=<deployer EOA> in shell or root .env.
#
# Note: symbol on-chain stays canonical mixed-case (STRCx) to match
# rwa.xyz / token_metadata.ticker. Equity → wider deviation envelope
# absorbs normal daily moves without bricking NAV refresh.

export MUHAVEN_TOKEN_SYMBOL=STRCx
export MUHAVEN_TOKEN_NAME="Strategy Variable xStock"
export MUHAVEN_NAV_INITIAL=99190000       # $99.19 × 1e6 (per-share)
export MUHAVEN_TREASURY_SEED=0
export MUHAVEN_INSTANT_CAP=100000
export MUHAVEN_MIN_INVESTMENT=1
export MUHAVEN_MAX_DEVIATION_BPS=1000     # 10% — equity, daily volatility envelope
export MUHAVEN_EPOCH_DURATION=86400
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR
unset  MUHAVEN_PAUSED

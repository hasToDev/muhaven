# scripts/env/usyc.env
#
# Wave 5 Q1 — wrap Circle USYC (rwa.xyz reference data layer).
# NAV seeded from oracle_snapshots.nav_dollar × 1e6 at 2026-05-19 ingest;
# nav-publisher refresh cycle keeps it current after deploy.
#
# Source via: bash scripts/onboard-token.sh usyc [prod|stage]
#
# PREREQ: export MUHAVEN_NAV_WRITER=<deployer EOA> in shell or root .env
#         (the EOA that holds setNAV rights on the new IssuerControlledOracle).

export MUHAVEN_TOKEN_SYMBOL=USYC
export MUHAVEN_TOKEN_NAME="Circle USYC"
export MUHAVEN_NAV_INITIAL=1125179        # $1.12517900 × 1e6
export MUHAVEN_TREASURY_SEED=0            # treasury fills from purchases
export MUHAVEN_INSTANT_CAP=100000         # 0.1 USDC cap → larger redeems queue
export MUHAVEN_MIN_INVESTMENT=1           # 1 wei share floor
export MUHAVEN_MAX_DEVIATION_BPS=250      # 2.5% — yield-bearing stable
export MUHAVEN_EPOCH_DURATION=86400       # 1 day
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR
unset  MUHAVEN_PAUSED

# scripts/env/onyc.env
#
# Wave 5 Q1 — wrap OnRe Tokenized Reinsurance (ONyc).
# NAV seeded from oracle_snapshots.nav_dollar × 1e6 at 2026-05-19 ingest;
# nav-publisher refresh cycle keeps it current after deploy.
#
# Source via: bash scripts/onboard-token.sh onyc [prod|stage]
#
# PREREQ: export MUHAVEN_NAV_WRITER=<deployer EOA> in shell or root .env.
#
# Note: symbol on-chain stays canonical mixed-case (ONyc) to match
# rwa.xyz / token_metadata.ticker. APY ~11% (highest in the catalog) →
# wider deviation envelope so daily NAV refreshes don't trip the gate.

export MUHAVEN_TOKEN_SYMBOL=ONyc
export MUHAVEN_TOKEN_NAME="OnRe Tokenized Reinsurance"
export MUHAVEN_NAV_INITIAL=1103931        # $1.10393128 × 1e6
export MUHAVEN_TREASURY_SEED=0
export MUHAVEN_INSTANT_CAP=100000
export MUHAVEN_MIN_INVESTMENT=1
export MUHAVEN_MAX_DEVIATION_BPS=500      # 5% — reinsurance + high APY → more daily drift
export MUHAVEN_EPOCH_DURATION=86400
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR
unset  MUHAVEN_PAUSED

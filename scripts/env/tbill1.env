# scripts/env/tbill1.env
#
# Source this file before running onboard-token.ts to onboard TBILL1.
# Values tuned for the low-balance Arb Sepolia testnet workflow:
#   - No treasury seed (treasury fills from purchases)
#   - 0.1 USDC instant cap (any larger redeem escalates to the queue)
#   - IssuerControlledOracle as the active oracle for immediate purchase
#     readiness (Chainlink Functions oracle is deployed but not yet
#     registered — swap via tokenRegistry.setOracle once DON fulfilment
#     is verified)
#
# Usage:
#   source scripts/env/tbill1.env
#   pnpm run onboard-token:testnet:stage
#
# To swap to the Chainlink oracle later:
#   1. Pre-build the FRED DGS3MO request CBOR off-chain
#   2. Set MUHAVEN_ORACLE_KIND=chainlink + MUHAVEN_CHAINLINK_CBOR=0x...
#   3. Re-run, OR call ChainlinkFunctionsOracle.setTokenConfig directly
#      then tokenRegistry.setOracle(token, chainlinkOracle).

export MUHAVEN_TOKEN_SYMBOL=TBILL1
export MUHAVEN_TOKEN_NAME="MuHaven Treasury Bill Series 1"
export MUHAVEN_NAV_INITIAL=1000000        # 1.000 USDC per share (real T-bill prices ~$1)
export MUHAVEN_TREASURY_SEED=0            # skip seed; treasury fills from purchases
export MUHAVEN_INSTANT_CAP=100000         # 0.1 USDC cap → larger redeems escalate to queue
export MUHAVEN_MIN_INVESTMENT=1           # 1 wei share = effectively no minimum
export MUHAVEN_MAX_DEVIATION_BPS=250      # 2.5% — Treasury yields are stable
export MUHAVEN_EPOCH_DURATION=86400       # 1 day
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR             # not used in issuer kind
unset  MUHAVEN_PAUSED                     # default: not paused

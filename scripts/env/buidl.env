# scripts/env/buidl.env
#
# Wave 5 Q1 — wrap BlackRock USD Institutional Digital Liquidity Fund (BUIDL).
# NAV seeded from oracle_snapshots.nav_dollar × 1e6 at 2026-05-19 ingest;
# nav-publisher refresh cycle keeps it current after deploy.
#
# Source via: bash scripts/onboard-token.sh buidl [prod|stage]
#
# PREREQ: export MUHAVEN_NAV_WRITER=<deployer EOA> in shell or root .env.

export MUHAVEN_TOKEN_SYMBOL=BUIDL
export MUHAVEN_TOKEN_NAME="BlackRock USD Liquidity Fund"
export MUHAVEN_NAV_INITIAL=1000000        # $1.00000000 × 1e6 (price-stable)
export MUHAVEN_TREASURY_SEED=0
export MUHAVEN_INSTANT_CAP=100000         # 0.1 USDC cap
export MUHAVEN_MIN_INVESTMENT=1
export MUHAVEN_MAX_DEVIATION_BPS=250      # 2.5% — price-stable money market
export MUHAVEN_EPOCH_DURATION=86400
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR
unset  MUHAVEN_PAUSED

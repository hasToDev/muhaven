# scripts/env/gold1.env
#
# Source this file before running onboard-token.ts to onboard GOLD1.
# Values tuned for the low-balance Arb Sepolia testnet workflow.
#
# IMPORTANT — synthetic NAV pick: real gold trades ~$2,300/oz which would
# make 0.1 USDC buy ~0.0000043 shares. For testnet UX we set NAV to 0.010
# USDC/share so 0.1 USDC buys 10 shares — meaningful numbers in the UI.
# This is consistent with PROGRESS.md Phase 8: "GOLD1 is a synthetic demo
# token — backed only by PUSDC in treasury, not actual gold custody.
# Mainnet migration to Chainlink XAU/USD is a constructor-arg swap."
#
# Usage:
#   source scripts/env/gold1.env
#   pnpm run onboard-token:testnet:stage

export MUHAVEN_TOKEN_SYMBOL=GOLD1
export MUHAVEN_TOKEN_NAME="MuHaven Gold Series 1"
export MUHAVEN_NAV_INITIAL=10000          # 0.010 USDC per share (synthetic for testnet)
export MUHAVEN_TREASURY_SEED=0            # skip seed; treasury fills from purchases
export MUHAVEN_INSTANT_CAP=100000         # 0.1 USDC cap
export MUHAVEN_MIN_INVESTMENT=1
export MUHAVEN_MAX_DEVIATION_BPS=500      # 5% — gold is more volatile than T-bills
export MUHAVEN_EPOCH_DURATION=86400       # 1 day
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR
unset  MUHAVEN_PAUSED

# scripts/env/cetes.env
#
# Wave 5 Q1 — wrap Etherfuse CETES (Mexican Treasury Bills).
# NAV seeded from oracle_snapshots.nav_dollar × 1e6 at 2026-05-19 ingest;
# nav-publisher refresh cycle keeps it current after deploy.
#
# Source via: bash scripts/onboard-token.sh cetes [prod|stage]
#
# PREREQ: export MUHAVEN_NAV_WRITER=<deployer EOA> in shell or root .env.

export MUHAVEN_TOKEN_SYMBOL=CETES
export MUHAVEN_TOKEN_NAME="Etherfuse CETES"
export MUHAVEN_NAV_INITIAL=66985          # $0.06698513 × 1e6 (sub-dollar par)
export MUHAVEN_TREASURY_SEED=0
export MUHAVEN_INSTANT_CAP=100000
export MUHAVEN_MIN_INVESTMENT=1
export MUHAVEN_MAX_DEVIATION_BPS=250      # 2.5% — sovereign T-bill, stable
export MUHAVEN_EPOCH_DURATION=86400
export MUHAVEN_ORACLE_KIND=issuer
unset  MUHAVEN_CHAINLINK_CBOR
unset  MUHAVEN_PAUSED
